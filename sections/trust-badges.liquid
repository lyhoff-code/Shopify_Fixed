{%- comment -%}
  SECCIÓN: Badges de Confianza

  ═══════════════════════════════════════════════════════════════════════════
  NOTAS:
  ═══════════════════════════════════════════════════════════════════════════

  Esta sección usa iconos SVG incluidos, no requiere imágenes.
  Los iconos representan:
  - Envío gratis/rápido
  - Garantía de devolución
  - Pago seguro
  - Atención al cliente

  Si deseas iconos personalizados, puedes subir imágenes de 50x50px.
  ═══════════════════════════════════════════════════════════════════════════
{%- endcomment -%}

<section class="trust-badges">
  <div class="container">
    <div class="trust-badges__wrapper">
      {%- for block in section.blocks -%}
        <div class="trust-badge" {{ block.shopify_attributes }}>
          <div class="trust-badge__icon">
            {%- case block.settings.icon -%}
              {%- when 'shipping' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 18H3c-.6 0-1-.4-1-1V7c0-.6.4-1 1-1h10c.6 0 1 .4 1 1v11"></path>
                  <path d="M14 9h4l4 4v4c0 .6-.4 1-1 1h-2"></path>
                  <circle cx="7" cy="18" r="2"></circle>
                  <path d="M15 18H9"></path>
                  <circle cx="17" cy="18" r="2"></circle>
                </svg>
              {%- when 'return' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                  <path d="M3 3v5h5"></path>
                </svg>
              {%- when 'secure' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              {%- when 'support' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              {%- when 'quality' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="6"></circle>
                  <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
                </svg>
              {%- when 'gift' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="8" width="18" height="4" rx="1"></rect>
                  <path d="M12 8v13"></path>
                  <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"></path>
                  <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"></path>
                </svg>
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            {%- endcase -%}
          </div>
          <div class="trust-badge__content">
            <p class="trust-badge__title">{{ block.settings.title }}</p>
            <p class="trust-badge__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}

      {%- comment -%} Defaults si no hay bloques {%- endcomment -%}
      {%- if section.blocks.size == 0 -%}
        <div class="trust-badge">
          <div class="trust-badge__icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 18H3c-.6 0-1-.4-1-1V7c0-.6.4-1 1-1h10c.6 0 1 .4 1 1v11"></path><path d="M14 9h4l4 4v4c0 .6-.4 1-1 1h-2"></path><circle cx="7" cy="18" r="2"></circle><path d="M15 18H9"></path><circle cx="17" cy="18" r="2"></circle></svg>
          </div>
          <div class="trust-badge__content">
            <p class="trust-badge__title">Envío Gratis</p>
            <p class="trust-badge__text">En pedidos +$500</p>
          </div>
        </div>
        <div class="trust-badge">
          <div class="trust-badge__icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
          </div>
          <div class="trust-badge__content">
            <p class="trust-badge__title">30 Días</p>
            <p class="trust-badge__text">Garantía de devolución</p>
          </div>
        </div>
        <div class="trust-badge">
          <div class="trust-badge__icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
          </div>
          <div class="trust-badge__content">
            <p class="trust-badge__title">Pago Seguro</p>
            <p class="trust-badge__text">100% protegido</p>
          </div>
        </div>
        <div class="trust-badge">
          <div class="trust-badge__icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div class="trust-badge__content">
            <p class="trust-badge__title">Soporte 24/7</p>
            <p class="trust-badge__text">Atención dedicada</p>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Badges de Confianza",
  "tag": "section",
  "class": "section-trust-badges",
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "shipping", "label": "Envío" },
            { "value": "return", "label": "Devolución" },
            { "value": "secure", "label": "Seguridad" },
            { "value": "support", "label": "Soporte" },
            { "value": "quality", "label": "Calidad" },
            { "value": "gift", "label": "Regalo" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Envío Gratis"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "En pedidos +$500"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Badges de Confianza",
      "blocks": [
        { "type": "badge", "settings": { "icon": "shipping", "title": "Envío Gratis", "text": "En pedidos +$500" } },
        { "type": "badge", "settings": { "icon": "return", "title": "30 Días", "text": "Garantía de devolución" } },
        { "type": "badge", "settings": { "icon": "secure", "title": "Pago Seguro", "text": "100% protegido" } },
        { "type": "badge", "settings": { "icon": "support", "title": "Soporte 24/7", "text": "Atención dedicada" } }
      ]
    }
  ]
}
{% endschema %}
