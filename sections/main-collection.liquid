{%- comment -%}
  SECCIÓN: Página de Colección Principal

  ═══════════════════════════════════════════════════════════════════════════
  IMÁGENES:
  ═══════════════════════════════════════════════════════════════════════════

  📸 IMAGEN DE ENCABEZADO DE COLECCIÓN (opcional):
     - Tamaño: 1920x400px (banner ancho)
     - Tipo: Imagen representativa de la categoría
     - Puede mostrar varios productos de la colección juntos
  ═══════════════════════════════════════════════════════════════════════════
{%- endcomment -%}

<section class="collection-page">
  <div class="container">

    {%- comment -%} Header de la colección {%- endcomment -%}
    <div class="collection-header">
      <h1 class="collection-header__title">{{ collection.title | default: 'Nombre de Colección' }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection-header__description">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Filtros y ordenación {%- endcomment -%}
    <div class="collection-filters">
      <p class="collection-filters__count">
        {{ collection.products_count | default: '24' }} productos
      </p>
      <div class="collection-filters__sort">
        <label class="collection-filters__sort-label" for="sort-select">Ordenar por:</label>
        <select id="sort-select" class="collection-filters__sort-select" data-sort-select>
          <option value="manual">Destacados</option>
          <option value="best-selling">Más vendidos</option>
          <option value="title-ascending">A-Z</option>
          <option value="title-descending">Z-A</option>
          <option value="price-ascending">Precio: Menor a Mayor</option>
          <option value="price-descending">Precio: Mayor a Menor</option>
          <option value="created-descending">Más recientes</option>
        </select>
      </div>
    </div>

    {%- comment -%} Grid de productos {%- endcomment -%}
    <div class="products-grid">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..8) -%}
          <div class="product-card">
            <div class="product-card__image-wrapper">
              <div class="image-placeholder" style="aspect-ratio: 1;">
                <svg class="image-placeholder__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                  <circle cx="9" cy="9" r="2"></circle>
                  <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                </svg>
                <p class="image-placeholder__text">📸 PRODUCTO</p>
              </div>
            </div>
            <div class="product-card__info">
              <p class="product-card__vendor">Marca</p>
              <h3 class="product-card__title">
                <a href="#">Producto {{ i }}</a>
              </h3>
              <div class="product-card__price">
                <span class="product-card__price-current">$299.00</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} Paginación {%- endcomment -%}
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" style="display: flex; justify-content: center; gap: 10px; margin-top: 60px;">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="btn btn--outline">
            &larr; Anterior
          </a>
        {%- endif -%}

        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="btn btn--outline">{{ part.title }}</a>
          {%- else -%}
            <span class="btn btn--primary">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}

        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="btn btn--outline">
            Siguiente &rarr;
          </a>
        {%- endif -%}
      </nav>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Colección Principal",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Productos por página",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "select",
      "id": "products_per_row",
      "label": "Productos por fila",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    }
  ]
}
{% endschema %}
