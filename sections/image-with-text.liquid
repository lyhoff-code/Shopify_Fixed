{%- comment -%}
  SECCIÓN: Imagen con Texto (Sobre Nosotros / Características)

  ═══════════════════════════════════════════════════════════════════════════
  IMÁGENES NECESARIAS:
  ═══════════════════════════════════════════════════════════════════════════

  📸 IMAGEN PRINCIPAL:
     - Tamaño: 800x600px o 800x800px
     - Formato: JPG de alta calidad
     - Tipo de imagen según el uso:

     Para "Sobre Nosotros":
       • Foto del equipo de trabajo
       • Imagen del taller/oficina/tienda física
       • Foto del fundador/a
       • Imagen de proceso artesanal

     Para "Características de Producto":
       • Detalle close-up del producto
       • Producto en uso/contexto
       • Comparativa antes/después

     Para "Por Qué Elegirnos":
       • Imagen de empaque de calidad
       • Proceso de control de calidad
       • Imagen de envío/logística

     - Estilo: Profesional, bien iluminada, en alta resolución
     - Consejo: Imagen que conecte emocionalmente con el cliente
  ═══════════════════════════════════════════════════════════════════════════
{%- endcomment -%}

{%- assign layout_reverse = section.settings.layout == 'image_right' -%}

<section class="image-text-section{% if layout_reverse %} image-text-section--reverse{% endif %}{% if section.settings.background_color != 'white' %} image-text-section--{{ section.settings.background_color }}{% endif %}" style="{% if section.settings.background_color == 'custom' %}background-color: {{ section.settings.custom_background }};{% endif %}">
  <div class="container">
    <div class="image-text__wrapper">

      {%- comment -%} Columna de imagen {%- endcomment -%}
      <div class="image-text__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            srcset="{{ section.settings.image | image_url: width: 400 }} 400w,
                    {{ section.settings.image | image_url: width: 600 }} 600w,
                    {{ section.settings.image | image_url: width: 800 }} 800w,
                    {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 992px) 100vw, 50vw"
            alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
            loading="lazy"
            class="image-text__image"
          >
        {%- else -%}
          <div class="image-placeholder" style="min-height: 500px;">
            <svg class="image-placeholder__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
              <circle cx="9" cy="9" r="2"></circle>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
            </svg>
            <p class="image-placeholder__text">📸 IMAGEN SOBRE NOSOTROS</p>
            <p class="image-placeholder__specs">
              Tamaño: 800x600px o 800x800px<br>
              Sugerencias:<br>
              • Foto del equipo<br>
              • Taller/tienda física<br>
              • Proceso de fabricación<br>
              • Fundador/a de la empresa
            </p>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Columna de contenido {%- endcomment -%}
      <div class="image-text__content">
        {%- if section.settings.subtitle != blank -%}
          <p class="image-text__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="image-text__title">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="image-text__description">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- comment -%} Lista de características {%- endcomment -%}
        {%- if section.blocks.size > 0 -%}
          <div class="image-text__features">
            {%- for block in section.blocks -%}
              <div class="image-text__feature" {{ block.shopify_attributes }}>
                <svg class="image-text__feature-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span class="image-text__feature-text">{{ block.settings.text }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--primary">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Imagen con Texto",
  "tag": "section",
  "class": "section-image-text",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Disposición",
      "options": [
        { "value": "image_left", "label": "Imagen a la izquierda" },
        { "value": "image_right", "label": "Imagen a la derecha" }
      ],
      "default": "image_left"
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Color de fondo",
      "options": [
        { "value": "white", "label": "Blanco" },
        { "value": "gray", "label": "Gris claro" },
        { "value": "custom", "label": "Personalizado" }
      ],
      "default": "white"
    },
    {
      "type": "color",
      "id": "custom_background",
      "label": "Color de fondo personalizado",
      "default": "#F8F9FA"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "Recomendado: 800x600px o 800x800px"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Sobre Nosotros"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Nuestra Historia y Pasión"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Somos una empresa comprometida con la calidad y la satisfacción de nuestros clientes. Cada producto que ofrecemos ha sido cuidadosamente seleccionado para garantizar la mejor experiencia.</p><p>Nuestra misión es brindar productos excepcionales con un servicio al cliente incomparable.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "Conocer Más"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Característica",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Calidad garantizada en todos nuestros productos"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Imagen con Texto",
      "blocks": [
        { "type": "feature", "settings": { "text": "Materiales de primera calidad" } },
        { "type": "feature", "settings": { "text": "Fabricación artesanal" } },
        { "type": "feature", "settings": { "text": "Envío rápido y seguro" } },
        { "type": "feature", "settings": { "text": "Atención personalizada" } }
      ]
    }
  ]
}
{% endschema %}
