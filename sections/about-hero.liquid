<section class="about-hero scroll-reveal">
  <div class="about-hero__container">
    <div class="about-hero__content">
      <span class="about-hero__subtitle">{{ section.settings.subtitle }}</span>
      <h1 class="about-hero__title">{{ section.settings.title }}</h1>
      <p class="about-hero__description">{{ section.settings.description }}</p>
    </div>
    {%- if section.settings.image != blank -%}
      <div class="about-hero__image">
        <img src="{{ section.settings.image | image_url: width: 800 }}"
             alt="{{ section.settings.image.alt | default: section.settings.title }}"
             loading="lazy">
      </div>
    {%- else -%}
      <div class="about-hero__image about-hero__image--placeholder">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="100" height="100" fill="#f5f5f5"/>
          <path d="M50 30C44.5 30 40 34.5 40 40C40 45.5 44.5 50 50 50C55.5 50 60 45.5 60 40C60 34.5 55.5 30 50 30ZM30 70C30 60 40 55 50 55C60 55 70 60 70 70V75H30V70Z" fill="#ccc"/>
        </svg>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .about-hero {
    padding: 80px 20px;
    background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
  }

  .about-hero__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .about-hero__subtitle {
    display: inline-block;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-secondary, #2D5A4A);
    margin-bottom: 16px;
  }

  .about-hero__title {
    font-size: 3rem;
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 24px;
    color: var(--color-primary, #1A1A1A);
  }

  .about-hero__description {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #666;
  }

  .about-hero__image img,
  .about-hero__image--placeholder {
    width: 100%;
    height: 500px;
    object-fit: cover;
    border-radius: 8px;
  }

  @media (max-width: 768px) {
    .about-hero__container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .about-hero__title {
      font-size: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "About Hero",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Purity Meets Science"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Founded in 2018, we set out with a simple mission: create skincare that works without compromising your health or the planet. Every formula is crafted with certified organic ingredients and backed by scientific research."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "About Hero"
    }
  ]
}
{% endschema %}
