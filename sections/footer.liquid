{%- comment -%}
  SECCIÓN: Footer Principal

  IMÁGENES NECESARIAS:
  - Logo del footer: El mismo logo de la tienda o versión en blanco para fondo oscuro
    Recomendado: PNG transparente, 300x75px
{%- endcomment -%}

<footer class="footer">
  <div class="container">
    <div class="footer__wrapper">

      {%- comment -%} Columna de la Marca {%- endcomment -%}
      <div class="footer__brand">
        <div class="footer__logo">
          {%- if settings.logo != blank -%}
            <img
              src="{{ settings.logo | image_url: width: 150 }}"
              alt="{{ shop.name | escape }}"
              width="150"
              height="auto"
              loading="lazy"
              class="footer__logo-image"
            >
          {%- else -%}
            <h3 class="footer__logo-text">{{ shop.name }}</h3>
          {%- endif -%}
        </div>

        <div class="footer__about">
          {{ settings.footer_about }}
        </div>

        {%- comment -%} Redes Sociales {%- endcomment -%}
        <div class="footer__social">
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          {%- endif -%}

          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          {%- endif -%}

          {%- if settings.social_twitter != blank -%}
            <a href="{{ settings.social_twitter }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Twitter/X">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          {%- endif -%}

          {%- if settings.social_youtube != blank -%}
            <a href="{{ settings.social_youtube }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="YouTube">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          {%- endif -%}

          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="TikTok">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Columna 1 - Enlaces {%- endcomment -%}
      <div class="footer__column">
        <h4 class="footer__column-title">{{ section.settings.column_1_title }}</h4>
        <ul class="footer__menu">
          {%- for link in section.settings.column_1_menu.links -%}
            <li>
              <a href="{{ link.url }}" class="footer__menu-link">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} Columna 2 - Enlaces {%- endcomment -%}
      <div class="footer__column">
        <h4 class="footer__column-title">{{ section.settings.column_2_title }}</h4>
        <ul class="footer__menu">
          {%- for link in section.settings.column_2_menu.links -%}
            <li>
              <a href="{{ link.url }}" class="footer__menu-link">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} Columna 3 - Contacto {%- endcomment -%}
      <div class="footer__column">
        <h4 class="footer__column-title">{{ section.settings.contact_title }}</h4>

        {%- if section.settings.contact_address != blank -%}
          <div class="footer__contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{{ section.settings.contact_address }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.contact_phone != blank -%}
          <div class="footer__contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>{{ section.settings.contact_phone }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.contact_email != blank -%}
          <div class="footer__contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>{{ section.settings.contact_email }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Footer Bottom {%- endcomment -%}
    <div class="footer__bottom">
      <div class="footer__bottom-wrapper">
        <p class="footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados.
        </p>

        <div class="footer__payments">
          {{ shop.enabled_payment_types | payment_type_svg_tag }}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Columna 1"
    },
    {
      "type": "text",
      "id": "column_1_title",
      "label": "Título",
      "default": "Tienda"
    },
    {
      "type": "link_list",
      "id": "column_1_menu",
      "label": "Menú",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Columna 2"
    },
    {
      "type": "text",
      "id": "column_2_title",
      "label": "Título",
      "default": "Información"
    },
    {
      "type": "link_list",
      "id": "column_2_menu",
      "label": "Menú"
    },
    {
      "type": "header",
      "content": "Contacto"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Título",
      "default": "Contacto"
    },
    {
      "type": "text",
      "id": "contact_address",
      "label": "Dirección"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Teléfono"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email"
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
