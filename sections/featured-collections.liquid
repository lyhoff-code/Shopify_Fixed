{%- comment -%}
  SECCIÓN: Colecciones Destacadas

  ═══════════════════════════════════════════════════════════════════════════
  IMÁGENES NECESARIAS:
  ═══════════════════════════════════════════════════════════════════════════

  📸 IMAGEN PRINCIPAL DE CADA COLECCIÓN:
     - Tamaño: 800x800px (cuadrada) para tarjetas normales
     - Tamaño: 1200x800px para la colección destacada grande
     - Formato: JPG de alta calidad
     - Tipo de imagen: Fotografía de estilo de vida mostrando varios
       productos de esa colección, o un producto hero de la categoría
     - Fondo: Preferiblemente limpio o en contexto de uso
     - Consejo: Usa imágenes coherentes en estilo para todas las colecciones
  ═══════════════════════════════════════════════════════════════════════════
{%- endcomment -%}

<section class="featured-collections">
  <div class="container">

    {%- comment -%} Encabezado de la sección {%- endcomment -%}
    <div class="section-header">
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="section-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="section-description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Grid de Colecciones {%- endcomment -%}
    <div class="collections-grid">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        <a
          href="{{ collection.url | default: '#' }}"
          class="collection-card{% if block.settings.large %} collection-card--large{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                      {{ block.settings.image | image_url: width: 600 }} 600w,
                      {{ block.settings.image | image_url: width: 800 }} 800w,
                      {{ block.settings.image | image_url: width: 1200 }} 1200w"
              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
              alt="{{ block.settings.title | default: collection.title | escape }}"
              loading="lazy"
              class="collection-card__image"
            >
          {%- elsif collection.image != blank -%}
            <img
              src="{{ collection.image | image_url: width: 800 }}"
              alt="{{ collection.title | escape }}"
              loading="lazy"
              class="collection-card__image"
            >
          {%- else -%}
            <div class="image-placeholder" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
              <svg class="image-placeholder__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                <circle cx="9" cy="9" r="2"></circle>
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
              </svg>
              <p class="image-placeholder__text">📸 IMAGEN DE COLECCIÓN</p>
              <p class="image-placeholder__specs">
                {%- if block.settings.large -%}
                  Tamaño: 1200x800px<br>
                {%- else -%}
                  Tamaño: 800x800px<br>
                {%- endif -%}
                Foto de productos o estilo de vida
              </p>
            </div>
          {%- endif -%}

          <div class="collection-card__overlay">
            <h3 class="collection-card__title">
              {{ block.settings.title | default: collection.title | default: 'Nombre de Colección' }}
            </h3>
            <p class="collection-card__count">
              {{ collection.products_count | default: '12' }} productos
            </p>
          </div>
        </a>
      {%- endfor -%}

      {%- comment -%} Mostrar placeholders si no hay bloques {%- endcomment -%}
      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..4) -%}
          <div class="collection-card{% if forloop.first %} collection-card--large{% endif %}">
            <div class="image-placeholder" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
              <svg class="image-placeholder__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                <circle cx="9" cy="9" r="2"></circle>
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
              </svg>
              <p class="image-placeholder__text">📸 IMAGEN DE COLECCIÓN {{ i }}</p>
              <p class="image-placeholder__specs">
                {%- if forloop.first -%}
                  Tamaño: 1200x800px (Colección destacada)<br>
                {%- else -%}
                  Tamaño: 800x800px<br>
                {%- endif -%}
                Fotografía de productos de esta categoría
              </p>
            </div>
            <div class="collection-card__overlay">
              <h3 class="collection-card__title">Colección {{ i }}</h3>
              <p class="collection-card__count">12 productos</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Colecciones Destacadas",
  "tag": "section",
  "class": "section-featured-collections",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Explora"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Nuestras Colecciones"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Descubre nuestra selección cuidadosamente curada de productos de alta calidad."
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título personalizado",
          "info": "Deja vacío para usar el título de la colección"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen personalizada",
          "info": "800x800px para normal, 1200x800px para grande"
        },
        {
          "type": "checkbox",
          "id": "large",
          "label": "Mostrar en tamaño grande",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colecciones Destacadas",
      "blocks": [
        { "type": "collection", "settings": { "large": true } },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
