[
  {
    "name": "theme_info",
    "theme_name": "Nordic Pure Organic",
    "theme_version": "2.0.0",
    "theme_author": "Premium Design",
    "theme_documentation_url": "https://help.shopify.com/",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "header",
        "content": "Paleta Nordic Pure"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Color primario (botones)",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Color secundario (acentos)",
        "default": "#2D5A4A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Color de acento",
        "default": "#2D5A4A"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Color del texto",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_text_light",
        "label": "Color del texto secundario",
        "default": "#6B6B6B"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Color de fondo",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_background_secondary",
        "label": "Color de fondo secundario",
        "default": "#F5F5F5"
      }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Fuente de títulos",
        "default": "cormorant_garamond_n6"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Fuente del cuerpo",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "Tamaño de fuente base",
        "min": 14,
        "max": 20,
        "step": 1,
        "default": 16,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo de la tienda",
        "info": "Recomendado: PNG transparente, minimalista"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Ancho del logo",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 180,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "Header fijo al hacer scroll",
        "default": true
      },
      {
        "type": "color",
        "id": "header_background",
        "label": "Color de fondo del header",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "color",
        "id": "footer_background",
        "label": "Color de fondo del footer",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "footer_text_color",
        "label": "Color del texto del footer",
        "default": "#FFFFFF"
      },
      {
        "type": "richtext",
        "id": "footer_about",
        "label": "Texto sobre la empresa",
        "default": "<p>Productos orgánicos de la más alta calidad. Formulaciones puras, resultados reales.</p>"
      }
    ]
  },
  {
    "name": "Redes Sociales",
    "settings": [
      {
        "type": "header",
        "content": "Enlaces a redes sociales"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_twitter",
        "label": "Twitter/X URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      }
    ]
  },
  {
    "name": "Productos",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Mostrar proveedor/marca",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_sale_badge",
        "label": "Mostrar etiqueta de oferta",
        "default": true
      },
      {
        "type": "select",
        "id": "product_image_ratio",
        "label": "Proporción de imagen de producto",
        "options": [
          { "value": "square", "label": "Cuadrada (1:1)" },
          { "value": "portrait", "label": "Vertical (3:4)" },
          { "value": "landscape", "label": "Horizontal (4:3)" }
        ],
        "default": "portrait"
      }
    ]
  },
  {
    "name": "Carrito",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Tipo de carrito",
        "options": [
          { "value": "drawer", "label": "Cajón lateral" },
          { "value": "page", "label": "Página completa" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_notes_enable",
        "label": "Permitir notas en el pedido",
        "default": true
      }
    ]
  },
  {
    "name": "Barra de Anuncios",
    "settings": [
      {
        "type": "checkbox",
        "id": "announcement_bar_enabled",
        "label": "Mostrar barra de anuncios",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Texto del anuncio",
        "default": "Envío gratis en pedidos +$999 · Ingredientes 100% naturales"
      },
      {
        "type": "color",
        "id": "announcement_bg_color",
        "label": "Color de fondo",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "announcement_text_color",
        "label": "Color del texto",
        "default": "#FFFFFF"
      }
    ]
  }
]
