[
  {
    "name": "theme_info",
    "theme_name": "Nordic Pure Organic",
    "theme_version": "2.0.0",
    "theme_author": "Premium Design",
    "theme_documentation_url": "https://help.shopify.com/",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Nordic Pure Palette"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color (buttons)",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary color (accents)",
        "default": "#2D5A4A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent color",
        "default": "#2D5A4A"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text color",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_text_light",
        "label": "Secondary text color",
        "default": "#6B6B6B"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background color",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_background_secondary",
        "label": "Secondary background color",
        "default": "#F5F5F5"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "cormorant_garamond_n6"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "Base font size",
        "min": 14,
        "max": 20,
        "step": 1,
        "default": 16,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Store logo",
        "info": "Recommended: Transparent PNG, minimalist design"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 180,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "Sticky header on scroll",
        "default": true
      },
      {
        "type": "color",
        "id": "header_background",
        "label": "Header background color",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "color",
        "id": "footer_background",
        "label": "Footer background color",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "footer_text_color",
        "label": "Footer text color",
        "default": "#FFFFFF"
      },
      {
        "type": "richtext",
        "id": "footer_about",
        "label": "About text",
        "default": "<p>Premium organic skincare. Pure formulations, real results.</p>"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "header",
        "content": "Social media links"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_twitter",
        "label": "Twitter/X URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      }
    ]
  },
  {
    "name": "Products",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show vendor/brand",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_sale_badge",
        "label": "Show sale badge",
        "default": true
      },
      {
        "type": "select",
        "id": "product_image_ratio",
        "label": "Product image ratio",
        "options": [
          { "value": "square", "label": "Square (1:1)" },
          { "value": "portrait", "label": "Portrait (3:4)" },
          { "value": "landscape", "label": "Landscape (4:3)" }
        ],
        "default": "portrait"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Side drawer" },
          { "value": "page", "label": "Full page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_notes_enable",
        "label": "Allow order notes",
        "default": true
      }
    ]
  },
  {
    "name": "Announcement Bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "announcement_bar_enabled",
        "label": "Show announcement bar",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement text",
        "default": "Free shipping on orders over $99 · 100% Natural Ingredients"
      },
      {
        "type": "color",
        "id": "announcement_bg_color",
        "label": "Background color",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "announcement_text_color",
        "label": "Text color",
        "default": "#FFFFFF"
      }
    ]
  }
]
