<!-- Elegant AI Chatbot - French-Organic Style -->
<div id="chatbot-advanced" class="chatbot-elegant">
  <!-- Chat toggle button -->
  <button class="chatbot-toggle-elegant" aria-label="Open chat">
    <span class="chatbot-toggle-icon">
      <svg viewBox="0 0 50 50" class="chatbot-svg-elegant">
        <defs>
          <linearGradient id="chatbotGradElegant" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#9CAF88"/>
            <stop offset="100%" stop-color="#7D9167"/>
          </linearGradient>
        </defs>
        <circle cx="25" cy="25" r="23" fill="url(#chatbotGradElegant)"/>
        <path d="M15 20 Q25 15 35 20 Q35 30 25 35 Q15 30 15 20 Z" fill="#FDFCFB" opacity="0.9"/>
        <circle cx="21" cy="23" r="2" fill="#4A3F35" class="chatbot-eye-elegant"/>
        <circle cx="29" cy="23" r="2" fill="#4A3F35" class="chatbot-eye-elegant"/>
        <path d="M21 28 Q25 31 29 28" stroke="#4A3F35" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      </svg>
    </span>
    <span class="chatbot-badge-elegant">1</span>
    <span class="chatbot-pulse-elegant"></span>
  </button>

  <!-- Chat window -->
  <div class="chatbot-window-elegant">
    <!-- Header -->
    <div class="chatbot-header-elegant">
      <div class="chatbot-header-avatar-elegant">
        <svg viewBox="0 0 50 50" class="chatbot-svg-elegant">
          <circle cx="25" cy="25" r="23" fill="#FDFCFB"/>
          <path d="M15 20 Q25 15 35 20 Q35 30 25 35 Q15 30 15 20 Z" fill="#9CAF88" opacity="0.3"/>
          <circle cx="21" cy="23" r="2" fill="#4A3F35"/>
          <circle cx="29" cy="23" r="2" fill="#4A3F35"/>
          <path d="M21 28 Q25 31 29 28" stroke="#4A3F35" stroke-width="1.5" fill="none" stroke-linecap="round"/>
        </svg>
        <span class="chatbot-status-elegant"></span>
      </div>
      <div class="chatbot-header-info-elegant">
        <h4>Sage</h4>
        <p>Your Beauty Concierge</p>
      </div>
      <div class="chatbot-header-actions-elegant">
        <button class="chatbot-minimize-elegant" aria-label="Minimize">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
        </button>
        <button class="chatbot-close-elegant" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Messages area -->
    <div class="chatbot-messages-elegant" id="chatbot-messages"></div>

    <!-- Quick actions -->
    <div class="chatbot-quick-elegant" id="chatbot-quick-actions">
      <button class="quick-action-elegant" data-action="skincare">Skincare advice</button>
      <button class="quick-action-elegant" data-action="products">Product help</button>
      <button class="quick-action-elegant" data-action="order">Order status</button>
      <button class="quick-action-elegant" data-action="quiz">Take skin quiz</button>
    </div>

    <!-- Input area -->
    <div class="chatbot-input-elegant">
      <div class="chatbot-input-wrapper-elegant">
        <input type="text" class="chatbot-input-field-elegant" placeholder="Ask me anything..." id="chatbot-input">
        <button class="chatbot-send-elegant" aria-label="Send message" id="chatbot-send">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
          </svg>
        </button>
      </div>
      <div class="chatbot-powered-elegant">
        <span>Powered by AI</span>
      </div>
    </div>
  </div>
</div>

<style>
/* French-Organic Elegant Chatbot */
.chatbot-elegant {
  position: fixed;
  bottom: 20px;
  right: 20px;
  z-index: 9999;
  font-family: var(--font-body, 'Georgia', serif);
}

/* Elegant Toggle Button */
.chatbot-toggle-elegant {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  border: 2px solid #9CAF88;
  background: linear-gradient(135deg, #FDFCFB, #F5F3F0);
  box-shadow: 0 4px 20px rgba(156, 175, 136, 0.25);
  cursor: pointer;
  position: relative;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: visible;
}

.chatbot-toggle-elegant:hover {
  transform: scale(1.05);
  box-shadow: 0 6px 25px rgba(156, 175, 136, 0.35);
}

.chatbot-elegant.open .chatbot-toggle-elegant {
  transform: scale(0);
  opacity: 0;
  pointer-events: none;
}

.chatbot-toggle-icon {
  width: 36px;
  height: 36px;
  display: block;
  margin: auto;
}

.chatbot-svg-elegant {
  width: 100%;
  height: 100%;
}

.chatbot-eye-elegant {
  animation: chatbotBlinkElegant 4s ease-in-out infinite;
}

@keyframes chatbotBlinkElegant {
  0%, 45%, 55%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(0.1); }
}

.chatbot-badge-elegant {
  position: absolute;
  top: -4px;
  right: -4px;
  width: 20px;
  height: 20px;
  background: #C9A9A6;
  color: #FDFCFB;
  border-radius: 50%;
  font-size: 11px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: badgePulseElegant 3s ease-in-out infinite;
}

@keyframes badgePulseElegant {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.chatbot-pulse-elegant {
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 1px solid #9CAF88;
  animation: togglePulseElegant 3s ease-out infinite;
}

@keyframes togglePulseElegant {
  0% { transform: scale(1); opacity: 0.6; }
  100% { transform: scale(1.4); opacity: 0; }
}

/* Elegant Chat Window */
.chatbot-window-elegant {
  position: absolute;
  bottom: 75px;
  right: 0;
  width: 360px;
  height: 520px;
  background: #FDFCFB;
  border: 1px solid rgba(156, 175, 136, 0.3);
  border-radius: 20px;
  box-shadow: 0 10px 50px rgba(74, 63, 53, 0.12);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: scale(0.9) translateY(20px);
  opacity: 0;
  pointer-events: none;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  transform-origin: bottom right;
}

.chatbot-elegant.open .chatbot-window-elegant {
  transform: scale(1) translateY(0);
  opacity: 1;
  pointer-events: auto;
}

/* Elegant Header */
.chatbot-header-elegant {
  display: flex;
  align-items: center;
  padding: 16px 20px;
  background: linear-gradient(135deg, #9CAF88, #7D9167);
  color: #FDFCFB;
}

.chatbot-header-avatar-elegant {
  position: relative;
  width: 42px;
  height: 42px;
  margin-right: 12px;
}

.chatbot-status-elegant {
  position: absolute;
  bottom: 1px;
  right: 1px;
  width: 10px;
  height: 10px;
  background: #D4C5A9;
  border: 2px solid #FDFCFB;
  border-radius: 50%;
  animation: statusPulseElegant 2.5s ease-in-out infinite;
}

@keyframes statusPulseElegant {
  0%, 100% { box-shadow: 0 0 0 0 rgba(212, 197, 169, 0.4); }
  50% { box-shadow: 0 0 0 5px rgba(212, 197, 169, 0); }
}

.chatbot-header-info-elegant {
  flex: 1;
}

.chatbot-header-info-elegant h4 {
  margin: 0;
  font-size: 1rem;
  font-weight: 500;
  letter-spacing: 1px;
}

.chatbot-header-info-elegant p {
  margin: 0;
  font-size: 0.75rem;
  opacity: 0.9;
  font-style: italic;
}

.chatbot-header-actions-elegant {
  display: flex;
  gap: 6px;
}

.chatbot-header-actions-elegant button {
  width: 30px;
  height: 30px;
  border: none;
  background: rgba(253, 252, 251, 0.2);
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FDFCFB;
  transition: background 0.3s ease;
}

.chatbot-header-actions-elegant button:hover {
  background: rgba(253, 252, 251, 0.3);
}

.chatbot-header-actions-elegant button svg {
  width: 14px;
  height: 14px;
}

/* Elegant Messages */
.chatbot-messages-elegant {
  flex: 1;
  padding: 20px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
  background: linear-gradient(180deg, #F5F3F0, #FDFCFB);
}

.chat-message-elegant {
  display: flex;
  gap: 10px;
  animation: messageSlideElegant 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes messageSlideElegant {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.chat-message-elegant.user {
  flex-direction: row-reverse;
}

.chat-avatar-elegant {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(156, 175, 136, 0.2), rgba(212, 197, 169, 0.2));
  border: 1px solid rgba(156, 175, 136, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #7D9167;
  flex-shrink: 0;
}

.chat-message-elegant.user .chat-avatar-elegant {
  background: linear-gradient(135deg, rgba(212, 197, 169, 0.3), rgba(201, 169, 166, 0.2));
  color: #6B5D4D;
}

.chat-content-elegant {
  max-width: 75%;
}

.chat-bubble-elegant {
  padding: 12px 16px;
  border-radius: 16px;
  font-size: 0.85rem;
  line-height: 1.6;
  color: #4A3F35;
}

.chat-message-elegant:not(.user) .chat-bubble-elegant {
  background: #FFFFFF;
  border: 1px solid rgba(156, 175, 136, 0.15);
  border-bottom-left-radius: 4px;
  box-shadow: 0 2px 8px rgba(74, 63, 53, 0.05);
}

.chat-message-elegant.user .chat-bubble-elegant {
  background: linear-gradient(135deg, #9CAF88, #7D9167);
  color: #FDFCFB;
  border-bottom-right-radius: 4px;
}

.chat-time-elegant {
  font-size: 0.65rem;
  color: #9CAF88;
  margin-top: 4px;
  padding: 0 4px;
  font-style: italic;
}

.chat-message-elegant.user .chat-time-elegant {
  text-align: right;
}

/* Elegant Typing indicator */
.typing-indicator-elegant {
  display: flex;
  gap: 5px;
  padding: 12px 16px;
  background: #FFFFFF;
  border: 1px solid rgba(156, 175, 136, 0.15);
  border-radius: 16px;
  border-bottom-left-radius: 4px;
  width: fit-content;
}

.typing-dot-elegant {
  width: 6px;
  height: 6px;
  background: #9CAF88;
  border-radius: 50%;
  animation: typingBounceElegant 1.6s ease-in-out infinite;
}

.typing-dot-elegant:nth-child(2) { animation-delay: 0.2s; }
.typing-dot-elegant:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounceElegant {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
  30% { transform: translateY(-6px); opacity: 1; }
}

/* Elegant Quick Actions */
.chatbot-quick-elegant {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 12px 20px;
  background: #FDFCFB;
  border-top: 1px solid rgba(156, 175, 136, 0.1);
}

.quick-action-elegant {
  padding: 8px 14px;
  border: 1px solid rgba(156, 175, 136, 0.3);
  border-radius: 20px;
  background: transparent;
  font-size: 0.75rem;
  color: #4A3F35;
  cursor: pointer;
  transition: all 0.3s ease;
  white-space: nowrap;
  letter-spacing: 0.3px;
}

.quick-action-elegant:hover {
  border-color: #9CAF88;
  background: rgba(156, 175, 136, 0.1);
  color: #7D9167;
}

/* Elegant Input Area */
.chatbot-input-elegant {
  padding: 14px 20px;
  background: #FDFCFB;
  border-top: 1px solid rgba(156, 175, 136, 0.1);
}

.chatbot-input-wrapper-elegant {
  display: flex;
  align-items: center;
  gap: 10px;
  background: #F5F3F0;
  border: 1px solid rgba(156, 175, 136, 0.2);
  border-radius: 25px;
  padding: 4px 6px 4px 18px;
}

.chatbot-input-field-elegant {
  flex: 1;
  border: none;
  background: none;
  padding: 10px 0;
  font-size: 0.9rem;
  color: #4A3F35;
  outline: none;
  font-family: inherit;
}

.chatbot-input-field-elegant::placeholder {
  color: #9CAF88;
  font-style: italic;
}

.chatbot-send-elegant {
  width: 38px;
  height: 38px;
  border: none;
  background: linear-gradient(135deg, #9CAF88, #7D9167);
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FDFCFB;
  transition: all 0.3s ease;
}

.chatbot-send-elegant:hover {
  transform: scale(1.05);
  box-shadow: 0 2px 10px rgba(156, 175, 136, 0.3);
}

.chatbot-send-elegant svg {
  width: 16px;
  height: 16px;
}

.chatbot-powered-elegant {
  text-align: center;
  margin-top: 10px;
  font-size: 0.65rem;
  color: #9CAF88;
  letter-spacing: 1px;
  text-transform: uppercase;
}

/* Mobile */
@media (max-width: 480px) {
  .chatbot-elegant {
    bottom: 10px;
    right: 10px;
  }

  .chatbot-window-elegant {
    width: calc(100vw - 20px);
    height: calc(100vh - 100px);
    bottom: 65px;
    right: -10px;
    border-radius: 16px;
  }

  .chatbot-toggle-elegant {
    width: 52px;
    height: 52px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const chatbot = document.getElementById('chatbot-advanced');
  const toggleBtn = chatbot.querySelector('.chatbot-toggle-elegant');
  const closeBtn = chatbot.querySelector('.chatbot-close-elegant');
  const minimizeBtn = chatbot.querySelector('.chatbot-minimize-elegant');
  const messagesContainer = document.getElementById('chatbot-messages');
  const input = document.getElementById('chatbot-input');
  const sendBtn = document.getElementById('chatbot-send');
  const quickActions = document.getElementById('chatbot-quick-actions');
  const badge = chatbot.querySelector('.chatbot-badge-elegant');

  // Elegant AI Knowledge Base
  const knowledge = {
    greetings: {
      patterns: ['hi', 'hello', 'hey', 'good morning', 'good afternoon', 'good evening', 'hola', 'bonjour'],
      responses: [
        "Bonjour! I'm Sage, your beauty concierge. How may I assist you today?",
        "Welcome! I'm here to help you discover your perfect skincare ritual. What brings you here?",
        "Hello! It's wonderful to meet you. I can help with product recommendations, skincare advice, or order questions."
      ]
    },
    skincare: {
      patterns: ['routine', 'skincare', 'skin care', 'advice', 'help skin', 'skin type'],
      responses: [
        "I'd be delighted to help with your skincare journey. For personalized recommendations, I suggest our Skin Quiz - it takes just moments and creates a bespoke routine for you.",
        "The foundation of beautiful skin: Cleanse, treat with serum, moisturize, and protect with SPF. Shall I recommend specific products for your skin type?"
      ]
    },
    products: {
      patterns: ['product', 'recommend', 'best', 'serum', 'cream', 'cleanser', 'moisturizer'],
      responses: [
        "Our curated collection features:\n\n- Vitamin C Serum - For luminous skin\n- Hyaluronic Acid - Deep hydration\n- Retinol Night Cream - Gentle renewal\n\nWhich interests you?",
        "I can certainly guide you. Our formulas are crafted with the finest organic ingredients. Are you seeking anti-aging, hydration, or brightening benefits?"
      ]
    },
    orders: {
      patterns: ['order', 'shipping', 'delivery', 'track', 'where is my', 'status'],
      responses: [
        "For order assistance:\n\n- Check your confirmation email\n- Visit our Track Order page\n- Share your order number with me\n\nWe ship within 1-2 days, delivery takes 3-5 days.",
        "I can help with your order. We offer complimentary shipping on orders over $99. Do you have an order number?"
      ]
    },
    returns: {
      patterns: ['return', 'refund', 'exchange', 'money back', 'not happy'],
      responses: [
        "We stand behind every product with our 30-day satisfaction guarantee. If something isn't quite right, contact us for a full refund or store credit.",
        "I'm sorry to hear that. We want you to be completely satisfied. Our team will ensure we make it right for you."
      ]
    },
    ingredients: {
      patterns: ['ingredient', 'organic', 'natural', 'chemical', 'paraben', 'vegan', 'cruelty'],
      responses: [
        "Our philosophy:\n\n- 95%+ certified organic\n- 100% vegan & cruelty-free\n- No parabens or synthetic fragrances\n\nWe believe in transparency and purity.",
        "We're devoted to clean beauty. Every ingredient is chosen for both efficacy and safety. Would you like to know about something specific?"
      ]
    },
    pricing: {
      patterns: ['price', 'cost', 'expensive', 'discount', 'sale', 'coupon', 'code'],
      responses: [
        "A few ways to save:\n\n- WELCOME15 - 15% off first order\n- Complimentary shipping on $99+\n- Rewards program - earn with every purchase\n\nShall I apply a code for you?",
        "Our products are an investment in your skin's future. Use WELCOME15 for 15% off your first order."
      ]
    },
    default: [
      "I'd love to help further. You might ask about:\n\n- Product recommendations\n- Skincare routines\n- Shipping & orders\n- Our ingredients\n\nOr email us at hello@organicskincare.com",
      "Let me know more about what you're looking for. I'm here to help with products, skincare advice, or orders."
    ]
  };

  let isOpen = false;
  let conversationHistory = [];

  toggleBtn.addEventListener('click', () => toggleChat(true));
  closeBtn.addEventListener('click', () => toggleChat(false));
  minimizeBtn.addEventListener('click', () => toggleChat(false));

  function toggleChat(open) {
    isOpen = open;
    chatbot.classList.toggle('open', open);
    badge.style.display = 'none';

    if (open && conversationHistory.length === 0) {
      setTimeout(() => {
        addBotMessage(getRandomResponse(knowledge.greetings.responses));
      }, 600);
    }
  }

  sendBtn.addEventListener('click', sendMessage);
  input.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') sendMessage();
  });

  function sendMessage() {
    const text = input.value.trim();
    if (!text) return;

    addUserMessage(text);
    input.value = '';

    showTyping();

    setTimeout(() => {
      hideTyping();
      const response = getAIResponse(text);
      addBotMessage(response);
    }, 1200 + Math.random() * 800);
  }

  function getAIResponse(text) {
    const lowerText = text.toLowerCase();

    for (const [category, data] of Object.entries(knowledge)) {
      if (category === 'default') continue;

      if (data.patterns.some(pattern => lowerText.includes(pattern))) {
        return getRandomResponse(data.responses);
      }
    }

    return getRandomResponse(knowledge.default);
  }

  function getRandomResponse(responses) {
    return responses[Math.floor(Math.random() * responses.length)];
  }

  function addUserMessage(text) {
    const html = `
      <div class="chat-message-elegant user">
        <div class="chat-avatar-elegant">You</div>
        <div class="chat-content-elegant">
          <div class="chat-bubble-elegant">${escapeHtml(text)}</div>
          <div class="chat-time-elegant">${getTime()}</div>
        </div>
      </div>
    `;
    messagesContainer.insertAdjacentHTML('beforeend', html);
    scrollToBottom();
    conversationHistory.push({ role: 'user', content: text });
  }

  function addBotMessage(text) {
    const formatted = text
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\n/g, '<br>');

    const html = `
      <div class="chat-message-elegant bot">
        <div class="chat-avatar-elegant">&#10047;</div>
        <div class="chat-content-elegant">
          <div class="chat-bubble-elegant">${formatted}</div>
          <div class="chat-time-elegant">${getTime()}</div>
        </div>
      </div>
    `;
    messagesContainer.insertAdjacentHTML('beforeend', html);
    scrollToBottom();
    conversationHistory.push({ role: 'bot', content: text });
  }

  function showTyping() {
    const html = `
      <div class="chat-message-elegant bot" id="typing-message">
        <div class="chat-avatar-elegant">&#10047;</div>
        <div class="chat-content-elegant">
          <div class="typing-indicator-elegant">
            <span class="typing-dot-elegant"></span>
            <span class="typing-dot-elegant"></span>
            <span class="typing-dot-elegant"></span>
          </div>
        </div>
      </div>
    `;
    messagesContainer.insertAdjacentHTML('beforeend', html);
    scrollToBottom();
  }

  function hideTyping() {
    const typing = document.getElementById('typing-message');
    if (typing) typing.remove();
  }

  function scrollToBottom() {
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  function getTime() {
    return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  quickActions.querySelectorAll('.quick-action-elegant').forEach(btn => {
    btn.addEventListener('click', function() {
      const action = this.dataset.action;

      switch(action) {
        case 'skincare':
          input.value = "I need skincare advice";
          sendMessage();
          break;
        case 'products':
          input.value = "Can you recommend some products?";
          sendMessage();
          break;
        case 'order':
          input.value = "I want to track my order";
          sendMessage();
          break;
        case 'quiz':
          addBotMessage("Wonderful choice! Our Skin Quiz will create your personalized routine. Let me open it for you.");
          setTimeout(() => {
            window.dispatchEvent(new CustomEvent('openSkinQuiz'));
          }, 1000);
          break;
      }
    });
  });

  setTimeout(() => {
    if (!isOpen) {
      badge.style.display = 'flex';
    }
  }, 12000);
});
</script>
