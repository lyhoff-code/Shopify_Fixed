</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('skin-quiz-modal');
  const overlay = modal.querySelector('.skin-quiz-overlay');
  const closeBtn = modal.querySelector('.skin-quiz-close');
  const prevBtn = modal.querySelector('.skin-quiz-prev');
  const nextBtn = modal.querySelector('.skin-quiz-next');
  const progressBar = modal.querySelector('.skin-quiz-progress-bar');
  const progressText = modal.querySelector('.skin-quiz-progress-text');
  const retakeBtn = modal.querySelector('.skin-quiz-retake');

  let currentStep = 1;
  const totalSteps = 5;
  const answers = {};

  // Open quiz
  window.addEventListener('openSkinQuiz', () => openQuiz());

  // Also add a trigger for nav link
  document.querySelectorAll('[href*="skin-quiz"], .skin-quiz-trigger').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      openQuiz();
    });
  });

  function openQuiz() {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeQuiz() {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  // Close handlers
  closeBtn.addEventListener('click', closeQuiz);
  overlay.addEventListener('click', closeQuiz);

  // Option selection
  modal.querySelectorAll('.skin-quiz-option').forEach(option => {
    option.addEventListener('click', function() {
      const step = this.closest('.skin-quiz-step');
      const isMulti = step.querySelector('.skin-quiz-options').classList.contains('multi');

      if (isMulti) {
        const selected = step.querySelectorAll('.skin-quiz-option.selected');
        if (this.classList.contains('selected')) {
          this.classList.remove('selected');
        } else if (selected.length < 2) {
          this.classList.add('selected');
        }
      } else {
        step.querySelectorAll('.skin-quiz-option').forEach(o => o.classList.remove('selected'));
        this.classList.add('selected');
      }

      updateNavigation();
    });
  });

  // Navigation
  prevBtn.addEventListener('click', () => {
    if (currentStep > 1) {
      goToStep(currentStep - 1);
    }
  });

  nextBtn.addEventListener('click', () => {
    saveAnswer();
    if (currentStep < totalSteps) {
      goToStep(currentStep + 1);
    } else {
      showResults();
    }
  });

  retakeBtn.addEventListener('click', () => {
    currentStep = 1;
    Object.keys(answers).forEach(key => delete answers[key]);
    modal.querySelectorAll('.skin-quiz-option.selected').forEach(o => o.classList.remove('selected'));
    goToStep(1);
  });

  function goToStep(step) {
    currentStep = step;

    modal.querySelectorAll('.skin-quiz-step').forEach(s => s.classList.remove('active'));
    modal.querySelector(`[data-step="${step}"]`).classList.add('active');

    updateProgress();
    updateNavigation();
  }

  function updateProgress() {
    const progress = ((currentStep - 1) / totalSteps) * 100;
    progressBar.style.width = progress + '%';
    progressText.textContent = `Question ${currentStep} of ${totalSteps}`;
  }

  function updateNavigation() {
    prevBtn.disabled = currentStep === 1;

    const currentStepEl = modal.querySelector(`[data-step="${currentStep}"]`);
    const hasSelection = currentStepEl.querySelector('.skin-quiz-option.selected');
    nextBtn.disabled = !hasSelection;
    nextBtn.textContent = currentStep === totalSteps ? 'See Results' : 'Next →';
  }

  function saveAnswer() {
    const stepEl = modal.querySelector(`[data-step="${currentStep}"]`);
    const selected = stepEl.querySelectorAll('.skin-quiz-option.selected');
    const values = Array.from(selected).map(o => o.dataset.value);
    answers[`step${currentStep}`] = values;
  }

  function showResults() {
    modal.querySelectorAll('.skin-quiz-step').forEach(s => s.classList.remove('active'));
    modal.querySelector('[data-step="results"]').classList.add('active');

    progressBar.style.width = '100%';
    progressText.textContent = 'Complete!';

    // Generate profile based on answers
    const profile = generateProfile();
    document.getElementById('quiz-profile-type').textContent = profile.type;
    document.getElementById('quiz-recommendations').innerHTML = profile.recommendations;

    // Hide nav for results
    modal.querySelector('.skin-quiz-nav').style.display = 'none';

    // Confetti!
    createConfetti();
  }

  function generateProfile() {
    const skinType = answers.step1?.[0] || 'normal';
    const concerns = answers.step2 || [];
    const age = answers.step3?.[0] || '26-35';

    const profiles = {
      dry: { type: 'Hydration Hero', emoji: '💧' },
      oily: { type: 'Balance Master', emoji: '⚖️' },
      combination: { type: 'Harmony Seeker', emoji: '🌿' },
      normal: { type: 'Glow Getter', emoji: '✨' },
      sensitive: { type: 'Gentle Guardian', emoji: '🌸' }
    };

    const profile = profiles[skinType];

    const recommendations = `
      <div class="recommendation-card">
        <span class="recommendation-step">1</span>
        <div class="recommendation-info">
          <h4>Gentle Organic Cleanser</h4>
          <p>Perfect for ${skinType} skin - removes impurities without stripping</p>
        </div>
      </div>
      <div class="recommendation-card">
        <span class="recommendation-step">2</span>
        <div class="recommendation-info">
          <h4>Vitamin C Brightening Serum</h4>
          <p>Addresses ${concerns[0] || 'dullness'} with powerful antioxidants</p>
        </div>
      </div>
      <div class="recommendation-card">
        <span class="recommendation-step">3</span>
        <div class="recommendation-info">
          <h4>${skinType === 'oily' ? 'Lightweight Gel Moisturizer' : 'Rich Botanical Cream'}</h4>
          <p>Ideal hydration level for your ${skinType} skin type</p>
        </div>
      </div>
      <div class="recommendation-card">
        <span class="recommendation-step">4</span>
        <div class="recommendation-info">
          <h4>Mineral SPF 30 Sunscreen</h4>
          <p>Essential daily protection with organic ingredients</p>
        </div>
      </div>
    `;

    return {
      type: `${profile.emoji} ${profile.type}`,
      recommendations
    };
  }

  function createConfetti() {
    const container = document.getElementById('quiz-confetti');
    const colors = ['#2D5A4A', '#3d7a64', '#8BC34A', '#FFD700', '#FF6B6B'];

    for (let i = 0; i < 50; i++) {
      const confetti = document.createElement('div');
      confetti.style.cssText = `
        position: absolute;
        width: 10px;
        height: 10px;
        background: ${colors[Math.floor(Math.random() * colors.length)]};
        left: ${Math.random() * 100}%;
        top: -10px;
        border-radius: ${Math.random() > 0.5 ? '50%' : '0'};
        animation: confettiFall ${2 + Math.random() * 2}s ease-out forwards;
        animation-delay: ${Math.random() * 0.5}s;
      `;
      container.appendChild(confetti);
    }

    // Add keyframes if not exists
    if (!document.getElementById('confetti-styles')) {
      const style = document.createElement('style');
      style.id = 'confetti-styles';
      style.textContent = `
        @keyframes confettiFall {
          to {
            transform: translateY(300px) rotate(720deg);
            opacity: 0;
          }
        }
      `;
      document.head.appendChild(style);
    }

    // Clean up
    setTimeout(() => {
      container.innerHTML = '';
    }, 4000);
  }

  // Initialize
  updateProgress();
  updateNavigation();
});
</script>
