}

/* Progress */
.skin-quiz-progress {
  padding: 20px 30px;
  border-bottom: 1px solid #eee;
}

.skin-quiz-progress-bar {
  height: 4px;
  background: linear-gradient(90deg, #2D5A4A, #3d7a64);
  border-radius: 2px;
  transition: width 0.5s ease;
}

.skin-quiz-progress-text {
  display: block;
  text-align: center;
  margin-top: 10px;
  font-size: 14px;
  color: #666;
}

/* Content */
.skin-quiz-content {
  padding: 30px;
}

.skin-quiz-step {
  display: none;
  animation: fadeInUp 0.4s ease;
}

.skin-quiz-step.active {
  display: block;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
