}

.skin-quiz-option:hover {
  border-color: #2D5A4A;
  background: #f8faf9;
}

.skin-quiz-option.selected {
  border-color: #2D5A4A;
  background: linear-gradient(135deg, rgba(45,90,74,0.1) 0%, rgba(45,90,74,0.05) 100%);
