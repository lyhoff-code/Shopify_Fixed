{%- comment -%}
  Welcome Popup with Discount
  Shows on first visit to capture emails
{%- endcomment -%}

<div class="welcome-popup" id="welcome-popup" data-welcome-popup>
  <div class="welcome-popup__overlay" data-popup-close></div>
  <div class="welcome-popup__container">
    <button class="welcome-popup__close" data-popup-close aria-label="Close popup">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="welcome-popup__content">
      <div class="welcome-popup__image">
        {%- if settings.popup_image != blank -%}
          <img src="{{ settings.popup_image | image_url: width: 600 }}" alt="Welcome offer" loading="lazy">
        {%- else -%}
          <div class="welcome-popup__image-placeholder">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </div>
        {%- endif -%}
      </div>

      <div class="welcome-popup__text">
        <span class="welcome-popup__badge">Welcome Gift</span>
        <h2 class="welcome-popup__title">Get 15% Off</h2>
        <p class="welcome-popup__subtitle">Your First Order</p>
        <p class="welcome-popup__description">Join our community and receive exclusive offers, skincare tips, and early access to new products.</p>

        <form class="welcome-popup__form" id="popup-form" action="/contact#contact_form" method="post">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter, popup">

          <div class="welcome-popup__input-group">
            <input
              type="email"
              name="contact[email]"
              placeholder="Enter your email"
              required
              autocomplete="email"
            >
            <button type="submit" class="btn btn--primary">
              Get My 15% Off
            </button>
          </div>
        </form>

        <p class="welcome-popup__disclaimer">
          By subscribing, you agree to our Privacy Policy. Unsubscribe anytime.
        </p>

        <button class="welcome-popup__skip" data-popup-close>
          No thanks, I'll pay full price
        </button>
      </div>
    </div>
  </div>
</div>
