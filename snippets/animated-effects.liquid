<script>
document.addEventListener('DOMContentLoaded', function() {
  // Elegant Page Loader
  const loader = document.getElementById('page-loader');
  if (loader) {
    window.addEventListener('load', () => {
      setTimeout(() => {
        loader.classList.add('loaded');
        setTimeout(() => {
          loader.style.display = 'none';
        }, 800);
      }, 1800);
    });

    // Fallback - hide loader after 5 seconds max
    setTimeout(() => {
      if (loader && !loader.classList.contains('loaded')) {
        loader.classList.add('loaded');
        setTimeout(() => {
          loader.style.display = 'none';
        }, 800);
      }
    }, 5000);
  }

  // Elegant Confetti System (botanical colors)
  const confettiCanvas = document.getElementById('confetti-canvas');
  const confettiCtx = confettiCanvas.getContext('2d');
  let confettiParticles = [];

  function resizeConfettiCanvas() {
    confettiCanvas.width = window.innerWidth;
    confettiCanvas.height = window.innerHeight;
  }
  resizeConfettiCanvas();
  window.addEventListener('resize', resizeConfettiCanvas);

  class ConfettiParticle {
    constructor(x, y) {
      this.x = x;
      this.y = y;
      this.size = Math.random() * 8 + 4;
      this.speedY = Math.random() * 2 + 1.5;
      this.speedX = (Math.random() - 0.5) * 3;
      this.rotation = Math.random() * 360;
      this.rotationSpeed = (Math.random() - 0.5) * 6;
      // French-organic colors
      this.color = ['#9CAF88', '#7D9167', '#D4C5A9', '#BFB093', '#C9A9A6', '#A8BC96'][Math.floor(Math.random() * 6)];
      this.shape = Math.random() > 0.5 ? 'leaf' : 'circle';
      this.opacity = 1;
    }

    update() {
      this.y += this.speedY;
      this.x += this.speedX + Math.sin(this.y * 0.02) * 0.5; // Gentle sway
      this.rotation += this.rotationSpeed;
      this.speedY += 0.05;
      this.opacity -= 0.008;
    }

    draw() {
      confettiCtx.save();
      confettiCtx.translate(this.x, this.y);
      confettiCtx.rotate(this.rotation * Math.PI / 180);
      confettiCtx.globalAlpha = this.opacity;
      confettiCtx.fillStyle = this.color;

      if (this.shape === 'leaf') {
        // Draw leaf shape
        confettiCtx.beginPath();
        confettiCtx.ellipse(0, 0, this.size, this.size / 2.5, 0, 0, Math.PI * 2);
        confettiCtx.fill();
      } else {
        confettiCtx.beginPath();
        confettiCtx.arc(0, 0, this.size / 2, 0, Math.PI * 2);
        confettiCtx.fill();
      }

      confettiCtx.restore();
    }
  }

  function createConfetti(x, y, count = 80) {
    for (let i = 0; i < count; i++) {
      confettiParticles.push(new ConfettiParticle(
        x + (Math.random() - 0.5) * 100,
        y
      ));
    }
    animateConfetti();
  }

  function animateConfetti() {
    confettiCtx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);

    confettiParticles = confettiParticles.filter(p => p.opacity > 0 && p.y < confettiCanvas.height);

    confettiParticles.forEach(p => {
      p.update();
      p.draw();
    });

    if (confettiParticles.length > 0) {
      requestAnimationFrame(animateConfetti);
    }
  }

  window.triggerConfetti = (x = window.innerWidth / 2, y = 0) => {
    createConfetti(x, y);
  };

  // Elegant Rewards System
  const rewardsPanel = document.getElementById('rewards-panel');
  const rewardsToggle = rewardsPanel.querySelector('.rewards-toggle-elegant');
  let rewardsPoints = parseInt(localStorage.getItem('rewardsPoints') || '0');

  function updateRewardsDisplay() {
    document.getElementById('reward-points').textContent = rewardsPoints;
    document.getElementById('rewards-balance').textContent = rewardsPoints;

    const tierProgress = document.getElementById('tier-progress');
    const tierStatus = document.getElementById('tier-status');

    let progress = 0;
    let statusText = '';

    if (rewardsPoints < 100) {
      progress = (rewardsPoints / 100) * 25;
      statusText = `${100 - rewardsPoints} points to Sprout`;
    } else if (rewardsPoints < 300) {
      progress = 25 + ((rewardsPoints - 100) / 200) * 25;
      statusText = `${300 - rewardsPoints} points to Bloom`;
    } else if (rewardsPoints < 600) {
      progress = 50 + ((rewardsPoints - 300) / 300) * 25;
      statusText = `${600 - rewardsPoints} points to Garden`;
    } else {
      progress = 100;
      statusText = `Welcome to the Garden`;
    }

    tierProgress.style.width = progress + '%';
    tierStatus.textContent = statusText;

    rewardsPanel.querySelectorAll('.redeem-btn-elegant').forEach(btn => {
      const points = parseInt(btn.closest('.redeem-option-elegant').dataset.points);
      btn.disabled = rewardsPoints < points;
    });

    localStorage.setItem('rewardsPoints', rewardsPoints);
  }

  window.addRewardsPoints = (points, showConfetti = true) => {
    rewardsPoints += points;
    updateRewardsDisplay();

    if (showConfetti && points >= 50) {
      window.triggerConfetti();
    }

    showPointsNotification(points);
  };

  function showPointsNotification(points) {
    const notification = document.createElement('div');
    notification.className = 'points-notification-elegant';
    notification.innerHTML = `+${points} points`;
    notification.style.cssText = `
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: linear-gradient(135deg, #FDFCFB, #F5F3F0);
      border: 1px solid #9CAF88;
      color: #4A3F35;
      padding: 20px 40px;
      border-radius: 30px;
      font-size: 1.2rem;
      font-weight: 400;
      letter-spacing: 2px;
      z-index: 99999;
      box-shadow: 0 10px 40px rgba(74, 63, 53, 0.15);
      animation: pointsPopInElegant 0.6s cubic-bezier(0.4, 0, 0.2, 1), pointsPopOutElegant 0.4s ease-in 1.5s forwards;
    `;

    document.body.appendChild(notification);
    setTimeout(() => notification.remove(), 2000);
  }

  const style = document.createElement('style');
  style.textContent = `
    @keyframes pointsPopInElegant {
      from { transform: translate(-50%, -50%) scale(0.8); opacity: 0; }
      to { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }
    @keyframes pointsPopOutElegant {
      to { transform: translate(-50%, -50%) scale(0.9); opacity: 0; }
    }
  `;
  document.head.appendChild(style);

  rewardsToggle.addEventListener('click', () => {
    rewardsPanel.classList.toggle('open');
  });

  rewardsPanel.querySelectorAll('.redeem-btn-elegant').forEach(btn => {
    btn.addEventListener('click', function() {
      const option = this.closest('.redeem-option-elegant');
      const points = parseInt(option.dataset.points);

      if (rewardsPoints >= points) {
        rewardsPoints -= points;
        updateRewardsDisplay();
        alert('Reward redeemed! Check your email for the discount code.');
      }
    });
  });

  updateRewardsDisplay();

  window.addEventListener('productAdded', () => {
    window.addRewardsPoints(10);
  });

  setTimeout(() => {
    if (rewardsPoints === 0) {
      window.addRewardsPoints(25, false);
    }
  }, 5000);
});
</script>
