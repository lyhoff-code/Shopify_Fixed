<style>
/* Modern 3D Doctor Mascot */
.doctor-mascot {
  position: fixed;
  bottom: 20px;
  left: 20px;
  z-index: 9996;
  font-family: var(--font-body, system-ui, sans-serif);
}

.doctor-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: scale(0) rotateY(-30deg);
  opacity: 0;
  transform-origin: bottom left;
  transition: transform 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55), opacity 0.4s ease;
  perspective: 1000px;
}

.doctor-mascot.active .doctor-container {
  transform: scale(1) rotateY(0deg);
  opacity: 1;
}

.doctor-character {
  position: relative;
  cursor: pointer;
  transform-style: preserve-3d;
}

.doctor-3d-wrapper {
  position: relative;
  transform-style: preserve-3d;
  animation: float3d 4s ease-in-out infinite;
}

@keyframes float3d {
  0%, 100% { transform: translateY(0) rotateX(0deg) rotateY(0deg); }
  25% { transform: translateY(-8px) rotateX(2deg) rotateY(3deg); }
  50% { transform: translateY(-5px) rotateX(0deg) rotateY(0deg); }
  75% { transform: translateY(-8px) rotateX(-2deg) rotateY(-3deg); }
}

.doctor-svg-modern {
  width: 120px;
  height: 155px;
  filter: drop-shadow(0 10px 20px rgba(0,0,0,0.15));
}

/* Body shadow animation */
.body-shadow {
  animation: shadowPulse 4s ease-in-out infinite;
}

@keyframes shadowPulse {
  0%, 100% { rx: 35; opacity: 0.1; }
  50% { rx: 30; opacity: 0.15; }
}

/* Eye animations */
.eyes-modern {
  animation: blink3d 4s ease-in-out infinite;
}

@keyframes blink3d {
  0%, 42%, 48%, 100% { transform: scaleY(1); }
  45% { transform: scaleY(0.1); }
}

.iris-left, .iris-right, .pupil-left, .pupil-right,
.iris-left-inner, .iris-right-inner {
  animation: eyeLook3d 6s ease-in-out infinite;
}

@keyframes eyeLook3d {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(2px); }
  40% { transform: translateX(-1px); }
  60% { transform: translateX(1px); }
  80% { transform: translateX(-2px); }
}

/* Waving arm */
.waving-arm {
  animation: wave3d 1.2s ease-in-out infinite;
  transform-origin: 105px 95px;
}

@keyframes wave3d {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-12deg); }
  75% { transform: rotate(12deg); }
}

/* Floating elements */
.floating-elements {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.float-icon {
  position: absolute;
  font-size: 16px;
  animation: floatIcon 3s ease-in-out infinite;
}

.float-1 {
  top: 10px;
  right: -10px;
  animation-delay: 0s;
}

.float-2 {
  top: 40px;
  left: -15px;
  animation-delay: 1s;
}

.float-3 {
  bottom: 50px;
  right: -5px;
  animation-delay: 2s;
}

@keyframes floatIcon {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.7; }
  50% { transform: translateY(-10px) scale(1.1); opacity: 1; }
}

/* Hover effects */
.doctor-character:hover .doctor-3d-wrapper {
  animation-play-state: paused;
  transform: translateY(-10px) scale(1.05);
}

.doctor-character:hover .smile-line {
  d: path("M58 58 Q70 72 82 58");
}

.doctor-character:hover .teeth {
  opacity: 1;
}

.doctor-character:hover .eyebrows-modern {
  transform: translateY(-3px);
}

/* Modern speech bubble */
.doctor-speech-modern {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-bottom: 15px;
  opacity: 0;
  transform: translateX(-50%) translateY(15px) scale(0.9);
  transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  pointer-events: none;
}

.speech-inner {
  background: linear-gradient(135deg, #FFFFFF 0%, #F8F9FA 100%);
  padding: 14px 20px;
  border-radius: 20px;
  box-shadow: 0 8px 30px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.08);
  white-space: nowrap;
  border: 1px solid rgba(255,255,255,0.8);
}

.speech-tail {
  position: absolute;
  bottom: -10px;
  left: 50%;
  transform: translateX(-50%);
  width: 20px;
  height: 20px;
  background: linear-gradient(135deg, #FFFFFF 0%, #F8F9FA 100%);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

.doctor-character:hover .doctor-speech-modern,
.doctor-mascot.speaking .doctor-speech-modern {
  opacity: 1;
  transform: translateX(-50%) translateY(0) scale(1);
}

.doctor-speech-text {
  font-size: 14px;
  color: #1A1A1A;
  font-weight: 600;
}

/* Modern action buttons */
.doctor-actions-modern {
  display: flex;
  gap: 12px;
  margin-top: 15px;
  opacity: 0;
  transform: translateY(-15px) rotateX(-20deg);
  transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55) 0.15s;
  perspective: 500px;
}

.doctor-mascot.active .doctor-actions-modern {
  opacity: 1;
  transform: translateY(0) rotateX(0deg);
}

.action-btn-3d {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  background: none;
  border: none;
  cursor: pointer;
  transition: transform 0.3s ease;
}

.action-btn-3d:hover {
  transform: translateY(-5px);
}

.btn-inner {
  width: 50px;
  height: 50px;
  border-radius: 16px;
  background: linear-gradient(145deg, #FFFFFF, #E6E6E6);
  box-shadow: 5px 5px 15px rgba(0,0,0,0.1), -5px -5px 15px rgba(255,255,255,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2D5A4A;
  transition: all 0.3s ease;
}

.action-btn-3d:hover .btn-inner {
  background: linear-gradient(145deg, #2D5A4A, #3d7a64);
  color: #fff;
  box-shadow: 5px 5px 20px rgba(45,90,74,0.3), -2px -2px 10px rgba(255,255,255,0.5);
}

.btn-inner svg {
  width: 24px;
  height: 24px;
}

.btn-label {
  font-size: 11px;
  font-weight: 600;
  color: #666;
  transition: color 0.3s ease;
}

.action-btn-3d:hover .btn-label {
  color: #2D5A4A;
}

/* Modern toggle button */
.doctor-toggle-modern {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 65px;
  height: 65px;
  border-radius: 50%;
  border: none;
  background: transparent;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.toggle-inner {
  width: 55px;
  height: 55px;
  border-radius: 50%;
  background: linear-gradient(145deg, #3d7a64, #2D5A4A);
  box-shadow: 5px 5px 20px rgba(45,90,74,0.4), -3px -3px 15px rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  z-index: 2;
}

.toggle-inner:hover {
  transform: scale(1.1);
  box-shadow: 8px 8px 25px rgba(45,90,74,0.5), -3px -3px 15px rgba(255,255,255,0.3);
}

.toggle-icon {
  font-size: 28px;
  animation: iconPulse3d 2s ease-in-out infinite;
}

@keyframes iconPulse3d {
  0%, 100% { transform: scale(1) rotateY(0deg); }
  50% { transform: scale(1.1) rotateY(10deg); }
}

.toggle-ring {
  position: absolute;
  width: 65px;
  height: 65px;
  border-radius: 50%;
  border: 2px solid rgba(45,90,74,0.3);
  animation: ringPulse3d 2s ease-out infinite;
}

.ring-2 {
  animation-delay: 1s;
}

@keyframes ringPulse3d {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(1.8); opacity: 0; }
}

.doctor-mascot.active .doctor-toggle-modern {
  transform: scale(0.7);
  opacity: 0.5;
}

/* Mobile */
@media (max-width: 768px) {
  .doctor-mascot {
    bottom: 15px;
    left: 15px;
  }

  .doctor-svg-modern {
    width: 100px;
    height: 130px;
  }

  .toggle-inner {
    width: 50px;
    height: 50px;
  }

  .toggle-ring {
    width: 55px;
    height: 55px;
  }

  .btn-inner {
    width: 45px;
    height: 45px;
    border-radius: 14px;
  }

  .btn-label {
    font-size: 10px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const mascot = document.getElementById('doctor-mascot');
  const toggle = mascot.querySelector('.doctor-toggle-modern');
  const character = mascot.querySelector('.doctor-character');
  const speechText = mascot.querySelector('.doctor-speech-text');
  const actionBtns = mascot.querySelectorAll('.action-btn-3d');

  const messages = {
    greeting: [
      "Hi! I'm Dr. James! 👨‍⚕️",
      "Welcome! Let's talk skincare! ✨",
      "Hello! Your skin expert is here! 💚",
      "Hey there! Ready for glowing skin? 🌟"
    ],
    tips: [
      "SPF every day - even indoors! ☀️",
      "Hydration = Happy skin! 💧",
      "Vitamin C in the AM, Retinol PM! ✨",
      "Always cleanse before bed! 🌙",
      "Patch test new products! 🧪",
      "Your skin barrier is everything! 🛡️"
    ],
    product: [
      "Excellent choice! Clinically proven! 👍",
      "This one's amazing for results! 💯",
      "My personal recommendation! ⭐",
      "Your skin will love this! 💚"
    ]
  };

  let isActive = false;
  let tipInterval;

  toggle.addEventListener('click', function() {
    isActive = !isActive;
    mascot.classList.toggle('active', isActive);

    if (isActive) {
      speak(getRandomMessage('greeting'));
      startTips();
    } else {
      stopTips();
    }
  });

  character.addEventListener('click', function() {
    speak(getRandomMessage('tips'));
  });

  actionBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const action = this.dataset.action;

      switch(action) {
        case 'quiz':
          speak("Let's analyze your skin! 🔬");
          setTimeout(() => window.dispatchEvent(new CustomEvent('openSkinQuiz')), 500);
          break;
        case 'chat':
          speak("Opening chat! 💬");
          setTimeout(() => {
            const chatBtn = document.querySelector('.chatbot-toggle-btn');
            if (chatBtn) chatBtn.click();
          }, 300);
          break;
        case 'help':
          speak("I'll help you! 🤝");
          window.location.href = '/pages/faq';
          break;
      }
    });
  });

  function speak(message) {
    speechText.textContent = message;
    mascot.classList.add('speaking');
    setTimeout(() => mascot.classList.remove('speaking'), 4000);
  }

  function getRandomMessage(category) {
    const msgs = messages[category];
    return msgs[Math.floor(Math.random() * msgs.length)];
  }

  function startTips() {
    tipInterval = setInterval(() => {
      if (isActive && Math.random() > 0.65) {
        speak(getRandomMessage('tips'));
      }
    }, 10000);
  }

  function stopTips() {
    clearInterval(tipInterval);
  }

  window.addEventListener('productAdded', () => {
    if (isActive) speak(getRandomMessage('product'));
  });

  setTimeout(() => {
    if (!isActive) toggle.click();
  }, 3500);
});
</script>
