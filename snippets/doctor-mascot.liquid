<!-- Dr. James - Sophisticated French-Organic Style -->
<div id="doctor-mascot" class="doctor-mascot" aria-hidden="true">
  <div class="doctor-container">
    <div class="doctor-character">
      <!-- Elegant Minimalist Doctor -->
      <div class="doctor-elegant-wrapper">
        <svg viewBox="0 0 120 150" class="doctor-svg-elegant">
          <defs>
            <!-- Sophisticated French-Organic Palette -->
            <linearGradient id="elegantCoat" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#FDFCFB"/>
              <stop offset="100%" stop-color="#F5F3F0"/>
            </linearGradient>
            <linearGradient id="elegantSkin" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#F8E8DC"/>
              <stop offset="100%" stop-color="#EBDCD0"/>
            </linearGradient>
            <linearGradient id="elegantHair" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#6B5B4F"/>
              <stop offset="100%" stop-color="#4A3F35"/>
            </linearGradient>
            <linearGradient id="sageGreen" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#9CAF88"/>
              <stop offset="100%" stop-color="#7D9167"/>
            </linearGradient>
            <linearGradient id="softGold" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#D4C5A9"/>
              <stop offset="100%" stop-color="#BFB093"/>
            </linearGradient>
            <!-- Subtle shadow -->
            <filter id="elegantShadow" x="-10%" y="-10%" width="120%" height="130%">
              <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#4A3F35" flood-opacity="0.08"/>
            </filter>
          </defs>

          <!-- Subtle ground shadow -->
          <ellipse cx="60" cy="145" rx="25" ry="4" fill="#E8E4DF" opacity="0.5"/>

          <!-- Elegant Lab Coat -->
          <g class="doctor-body-elegant" filter="url(#elegantShadow)">
            <!-- Inner shirt - sage green -->
            <path d="M40 72 L40 135 L80 135 L80 72 Q80 62 60 58 Q40 62 40 72 Z" fill="url(#sageGreen)" opacity="0.3"/>

            <!-- Coat - cream white -->
            <path d="M32 75 L32 138 C32 140 34 142 38 142 L50 142 L50 85 L70 85 L70 142 L82 142 C86 142 88 140 88 138 L88 75 Q88 63 60 58 Q32 63 32 75 Z" fill="url(#elegantCoat)" stroke="#E8E4DF" stroke-width="0.5"/>

            <!-- Coat collar detail -->
            <path d="M45 68 L52 78 L60 72 L68 78 L75 68" fill="none" stroke="#E8E4DF" stroke-width="1"/>

            <!-- Minimal pocket -->
            <rect x="38" y="95" width="12" height="14" rx="2" fill="none" stroke="#E8E4DF" stroke-width="0.5"/>

            <!-- Single elegant button -->
            <circle cx="60" cy="100" r="2.5" fill="#D4C5A9" stroke="#BFB093" stroke-width="0.5"/>
            <circle cx="60" cy="115" r="2.5" fill="#D4C5A9" stroke="#BFB093" stroke-width="0.5"/>
          </g>

          <!-- Neck -->
          <rect x="52" y="48" width="16" height="14" fill="url(#elegantSkin)" rx="3"/>

          <!-- Head -->
          <g class="doctor-head-elegant" filter="url(#elegantShadow)">
            <ellipse cx="60" cy="32" rx="24" ry="26" fill="url(#elegantSkin)"/>

            <!-- Ears -->
            <ellipse cx="36" cy="35" rx="4" ry="6" fill="url(#elegantSkin)"/>
            <ellipse cx="84" cy="35" rx="4" ry="6" fill="url(#elegantSkin)"/>

            <!-- Refined hair style -->
            <path d="M36 30 Q34 10 60 6 Q86 10 84 30 Q84 22 75 18 Q60 14 48 18 Q38 22 36 30 Z" fill="url(#elegantHair)"/>
            <path d="M42 25 Q50 18 62 20" stroke="rgba(255,255,255,0.15)" stroke-width="2" fill="none" stroke-linecap="round"/>

            <!-- Subtle eyebrows -->
            <path d="M45 24 Q50 22 55 24" stroke="#6B5B4F" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.7"/>
            <path d="M65 24 Q70 22 75 24" stroke="#6B5B4F" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.7"/>

            <!-- Elegant glasses - thin gold frames -->
            <g class="glasses-elegant">
              <ellipse cx="48" cy="32" rx="9" ry="7" fill="none" stroke="url(#softGold)" stroke-width="1"/>
              <ellipse cx="72" cy="32" rx="9" ry="7" fill="none" stroke="url(#softGold)" stroke-width="1"/>
              <path d="M57 31 L63 31" stroke="url(#softGold)" stroke-width="1"/>
              <path d="M39 31 L36 29" stroke="url(#softGold)" stroke-width="1"/>
              <path d="M81 31 L84 29" stroke="url(#softGold)" stroke-width="1"/>
            </g>

            <!-- Soft eyes -->
            <g class="eyes-elegant">
              <ellipse cx="48" cy="33" rx="5" ry="6" fill="#FDFCFB"/>
              <ellipse cx="72" cy="33" rx="5" ry="6" fill="#FDFCFB"/>
              <circle cx="49" cy="34" r="3" fill="#7D9167"/>
              <circle cx="73" cy="34" r="3" fill="#7D9167"/>
              <circle cx="49" cy="34" r="1.5" fill="#4A3F35"/>
              <circle cx="73" cy="34" r="1.5" fill="#4A3F35"/>
              <ellipse cx="50" cy="32" rx="1.2" ry="0.8" fill="#FFFFFF"/>
              <ellipse cx="74" cy="32" rx="1.2" ry="0.8" fill="#FFFFFF"/>
            </g>

            <!-- Refined nose -->
            <path d="M60 38 Q61 42 60 45" stroke="#EBDCD0" stroke-width="1.5" fill="none" stroke-linecap="round"/>

            <!-- Gentle smile -->
            <path class="smile-elegant" d="M53 50 Q60 55 67 50" stroke="#C9A798" stroke-width="1.5" fill="none" stroke-linecap="round"/>

            <!-- Subtle cheek color -->
            <ellipse cx="40" cy="42" rx="4" ry="2.5" fill="#E8B4A0" opacity="0.2"/>
            <ellipse cx="80" cy="42" rx="4" ry="2.5" fill="#E8B4A0" opacity="0.2"/>
          </g>

          <!-- Elegant ID Badge -->
          <g class="badge-elegant">
            <rect x="72" y="78" width="16" height="22" rx="2" fill="#FDFCFB" stroke="#E8E4DF" stroke-width="0.5"/>
            <rect x="74" y="80" width="12" height="3" rx="1" fill="url(#sageGreen)" opacity="0.6"/>
            <circle cx="80" cy="90" r="4" fill="#F5F3F0"/>
            <text x="80" y="100" text-anchor="middle" font-size="4" fill="#6B5B4F" font-family="serif">Dr. James</text>
          </g>

          <!-- Subtle waving hand -->
          <g class="wave-elegant">
            <path d="M88 80 Q100 75 102 88" stroke="url(#elegantCoat)" stroke-width="10" fill="none" stroke-linecap="round"/>
            <circle cx="103" cy="90" r="7" fill="url(#elegantSkin)"/>
          </g>
        </svg>

        <!-- Floating botanical elements -->
        <div class="floating-botanicals">
          <span class="botanical b1">🌿</span>
          <span class="botanical b2">✧</span>
          <span class="botanical b3">❋</span>
        </div>
      </div>

      <!-- Elegant speech bubble -->
      <div class="doctor-speech-elegant">
        <span class="speech-text-elegant">Bonjour! I'm Dr. James ✧</span>
      </div>
    </div>

    <!-- Refined action buttons -->
    <div class="doctor-actions-elegant">
      <button class="action-btn-elegant" data-action="quiz" title="Skin Analysis">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/>
          <rect x="9" y="3" width="6" height="4" rx="1"/>
          <path d="M9 14l2 2 4-4"/>
        </svg>
      </button>
      <button class="action-btn-elegant" data-action="chat" title="Consultation">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
      </button>
      <button class="action-btn-elegant" data-action="help" title="Guide">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Refined toggle button -->
  <button class="doctor-toggle-elegant" aria-label="Parlez avec Dr. James">
    <span class="toggle-icon-elegant">🌿</span>
  </button>
</div>

<style>
/* Sophisticated French-Organic Style */
.doctor-mascot {
  position: fixed;
  bottom: 24px;
  left: 24px;
  z-index: 9996;
  font-family: 'Cormorant Garamond', Georgia, serif;
}

.doctor-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: scale(0) translateY(20px);
  opacity: 0;
  transform-origin: bottom left;
  transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1), opacity 0.6s ease;
}

.doctor-mascot.active .doctor-container {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.doctor-character {
  position: relative;
  cursor: pointer;
}

.doctor-elegant-wrapper {
  position: relative;
}

.doctor-svg-elegant {
  width: 100px;
  height: 125px;
  filter: drop-shadow(0 4px 12px rgba(74, 63, 53, 0.08));
}

/* Subtle floating animation */
.doctor-elegant-wrapper {
  animation: elegantFloat 6s ease-in-out infinite;
}

@keyframes elegantFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}

/* Gentle eye blink */
.eyes-elegant {
  animation: elegantBlink 5s ease-in-out infinite;
}

@keyframes elegantBlink {
  0%, 42%, 48%, 100% { transform: scaleY(1); }
  45% { transform: scaleY(0.1); }
}

/* Subtle wave */
.wave-elegant {
  animation: elegantWave 3s ease-in-out infinite;
  transform-origin: 88px 80px;
}

@keyframes elegantWave {
  0%, 100% { transform: rotate(0deg); }
  50% { transform: rotate(8deg); }
}

/* Floating botanicals */
.floating-botanicals {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.botanical {
  position: absolute;
  font-size: 12px;
  opacity: 0.4;
  animation: botanicalFloat 8s ease-in-out infinite;
}

.b1 { top: 5px; right: -8px; animation-delay: 0s; }
.b2 { top: 30px; left: -10px; animation-delay: 2s; font-size: 10px; color: #9CAF88; }
.b3 { bottom: 40px; right: -5px; animation-delay: 4s; font-size: 10px; color: #D4C5A9; }

@keyframes botanicalFloat {
  0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.3; }
  50% { transform: translateY(-8px) rotate(5deg); opacity: 0.6; }
}

/* Hover effects */
.doctor-character:hover .doctor-elegant-wrapper {
  animation-play-state: paused;
}

.doctor-character:hover .smile-elegant {
  d: path("M52 49 Q60 57 68 49");
}

/* Elegant speech bubble */
.doctor-speech-elegant {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-bottom: 12px;
  background: #FDFCFB;
  padding: 12px 18px;
  border-radius: 20px;
  box-shadow: 0 4px 20px rgba(74, 63, 53, 0.08);
  border: 1px solid #E8E4DF;
  opacity: 0;
  transform: translateX(-50%) translateY(10px);
  transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  pointer-events: none;
}

.doctor-speech-elegant::after {
  content: '';
  position: absolute;
  bottom: -8px;
  left: 50%;
  transform: translateX(-50%);
  border-left: 8px solid transparent;
  border-right: 8px solid transparent;
  border-top: 8px solid #FDFCFB;
}

.doctor-character:hover .doctor-speech-elegant,
.doctor-mascot.speaking .doctor-speech-elegant {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.speech-text-elegant {
  font-size: 13px;
  color: #4A3F35;
  font-weight: 400;
  letter-spacing: 0.3px;
  white-space: nowrap;
}

/* Refined action buttons */
.doctor-actions-elegant {
  display: flex;
  gap: 10px;
  margin-top: 12px;
  opacity: 0;
  transform: translateY(-10px);
  transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1) 0.1s;
}

.doctor-mascot.active .doctor-actions-elegant {
  opacity: 1;
  transform: translateY(0);
}

.action-btn-elegant {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 1px solid #E8E4DF;
  background: #FDFCFB;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7D9167;
  transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}

.action-btn-elegant:hover {
  background: #9CAF88;
  border-color: #9CAF88;
  color: #FDFCFB;
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(156, 175, 136, 0.25);
}

.action-btn-elegant svg {
  width: 20px;
  height: 20px;
}

/* Elegant toggle button */
.doctor-toggle-elegant {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  border: 1px solid #E8E4DF;
  background: linear-gradient(145deg, #FDFCFB, #F5F3F0);
  box-shadow: 0 4px 20px rgba(74, 63, 53, 0.1);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}

.doctor-toggle-elegant:hover {
  transform: scale(1.08);
  box-shadow: 0 6px 25px rgba(74, 63, 53, 0.15);
  border-color: #9CAF88;
}

.toggle-icon-elegant {
  font-size: 24px;
  animation: gentlePulse 4s ease-in-out infinite;
}

@keyframes gentlePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

.doctor-mascot.active .doctor-toggle-elegant {
  transform: scale(0.8);
  opacity: 0.6;
}

/* Mobile */
@media (max-width: 768px) {
  .doctor-mascot {
    bottom: 16px;
    left: 16px;
  }

  .doctor-svg-elegant {
    width: 85px;
    height: 106px;
  }

  .doctor-toggle-elegant {
    width: 46px;
    height: 46px;
  }

  .action-btn-elegant {
    width: 38px;
    height: 38px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const mascot = document.getElementById('doctor-mascot');
  const toggle = mascot.querySelector('.doctor-toggle-elegant');
  const character = mascot.querySelector('.doctor-character');
  const speechText = mascot.querySelector('.speech-text-elegant');
  const actionBtns = mascot.querySelectorAll('.action-btn-elegant');

  const messages = {
    greeting: [
      "Bonjour! I'm Dr. James ✧",
      "Welcome to pure beauty ❋",
      "Hello, beauty awaits ✧",
      "Bienvenue! Let's glow ❋"
    ],
    tips: [
      "Gentle care, lasting beauty ✧",
      "Less is more, always ❋",
      "Your skin tells a story ✧",
      "Nature knows best ❋",
      "Patience brings radiance ✧",
      "Hydrate from within ❋"
    ],
    product: [
      "Exquisite choice ✧",
      "Pure elegance ❋",
      "Beautifully curated ✧",
      "Refined selection ❋"
    ]
  };

  let isActive = false;
  let tipInterval;

  toggle.addEventListener('click', function() {
    isActive = !isActive;
    mascot.classList.toggle('active', isActive);

    if (isActive) {
      speak(getRandomMessage('greeting'));
      startTips();
    } else {
      stopTips();
    }
  });

  character.addEventListener('click', function() {
    speak(getRandomMessage('tips'));
  });

  actionBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const action = this.dataset.action;

      switch(action) {
        case 'quiz':
          speak("Discover your ritual ✧");
          setTimeout(() => window.dispatchEvent(new CustomEvent('openSkinQuiz')), 600);
          break;
        case 'chat':
          speak("Let's consult ❋");
          setTimeout(() => {
            const chatBtn = document.querySelector('.chatbot-toggle-btn');
            if (chatBtn) chatBtn.click();
          }, 400);
          break;
        case 'help':
          speak("Your guide awaits ✧");
          window.location.href = '/pages/faq';
          break;
      }
    });
  });

  function speak(message) {
    speechText.textContent = message;
    mascot.classList.add('speaking');
    setTimeout(() => mascot.classList.remove('speaking'), 4500);
  }

  function getRandomMessage(category) {
    const msgs = messages[category];
    return msgs[Math.floor(Math.random() * msgs.length)];
  }

  function startTips() {
    tipInterval = setInterval(() => {
      if (isActive && Math.random() > 0.7) {
        speak(getRandomMessage('tips'));
      }
    }, 12000);
  }

  function stopTips() {
    clearInterval(tipInterval);
  }

  window.addEventListener('productAdded', () => {
    if (isActive) speak(getRandomMessage('product'));
  });

  setTimeout(() => {
    if (!isActive) toggle.click();
  }, 4000);
});
</script>
