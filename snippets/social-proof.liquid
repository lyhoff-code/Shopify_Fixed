<!-- Elegant Social Proof Notifications - French-Organic Style -->
<div id="social-proof-container" class="social-proof-container-elegant"></div>

<style>
.social-proof-container-elegant {
  position: fixed;
  bottom: 200px;
  left: 20px;
  z-index: 9990;
  display: flex;
  flex-direction: column;
  gap: 10px;
  pointer-events: none;
}

.social-proof-notification-elegant {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 18px;
  background: linear-gradient(135deg, #FDFCFB, #F5F3F0);
  border: 1px solid rgba(156, 175, 136, 0.3);
  border-radius: 16px;
  box-shadow: 0 4px 25px rgba(74, 63, 53, 0.1);
  transform: translateX(-120%);
  opacity: 0;
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: auto;
  max-width: 300px;
  cursor: pointer;
  position: relative;
}

.social-proof-notification-elegant.show {
  transform: translateX(0);
  opacity: 1;
}

.social-proof-notification-elegant.hide {
  transform: translateX(-120%);
  opacity: 0;
}

.social-proof-image-elegant {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(156, 175, 136, 0.15), rgba(212, 197, 169, 0.15));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
  overflow: hidden;
  border: 1px solid rgba(156, 175, 136, 0.2);
}

.social-proof-image-elegant img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.social-proof-content-elegant {
  flex: 1;
  min-width: 0;
}

.social-proof-title-elegant {
  font-size: 0.75rem;
  color: #6B5D4D;
  margin-bottom: 3px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.social-proof-message-elegant {
  font-size: 0.85rem;
  font-weight: 500;
  color: #4A3F35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.social-proof-time-elegant {
  font-size: 0.7rem;
  color: #9CAF88;
  margin-top: 3px;
  font-style: italic;
}

.social-proof-close-elegant {
  position: absolute;
  top: 8px;
  right: 10px;
  width: 18px;
  height: 18px;
  border: none;
  background: none;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.3s ease;
  font-size: 14px;
  color: #9CAF88;
}

.social-proof-notification-elegant:hover .social-proof-close-elegant {
  opacity: 1;
}

/* Notification type accents */
.social-proof-notification-elegant.purchase {
  border-left: 3px solid #9CAF88;
}

.social-proof-notification-elegant.review {
  border-left: 3px solid #D4C5A9;
}

.social-proof-notification-elegant.visitor {
  border-left: 3px solid #C9A9A6;
}

.social-proof-notification-elegant.stock {
  border-left: 3px solid #BFB093;
}

/* Subtle icon animation */
.social-proof-icon-elegant {
  animation: socialProofFloat 3s ease-in-out infinite;
}

@keyframes socialProofFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-2px); }
}

/* Mobile adjustments */
@media (max-width: 768px) {
  .social-proof-container-elegant {
    left: 10px;
    bottom: 120px;
  }

  .social-proof-notification-elegant {
    max-width: 260px;
    padding: 12px 14px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const container = document.getElementById('social-proof-container');

  // Elegant notification data
  const notifications = [
    {
      type: 'purchase',
      icon: '&#10047;',
      title: 'New Order',
      products: ['Vitamin C Serum', 'Hyaluronic Acid', 'Retinol Night Cream', 'Gentle Cleanser', 'Mineral SPF'],
      locations: ['Paris', 'New York', 'London', 'Milan', 'Barcelona', 'Amsterdam', 'Geneva', 'Monaco']
    },
    {
      type: 'review',
      icon: '&#10022;',
      title: 'New Review',
      messages: [
        '"Absolutely divine product"',
        '"My skin has never been better"',
        '"Pure luxury for the skin"',
        '"Finally, quality I can trust"',
        '"Elegant and effective"'
      ],
      names: ['Sophie L.', 'Charlotte M.', 'Isabelle R.', 'Victoria K.', 'Alexandra T.']
    },
    {
      type: 'visitor',
      icon: '&#10048;',
      title: 'Popular Now',
      messages: [
        '18 people viewing',
        '12 added to cart today',
        'Bestseller this week',
        '34 sold recently'
      ]
    },
    {
      type: 'stock',
      icon: '&#10070;',
      title: 'Limited Availability',
      messages: [
        'Only 4 remaining',
        'Selling quickly',
        'Almost gone',
        'Last few in stock'
      ]
    }
  ];

  const times = ['just now', 'moments ago', '2 min ago', '5 min ago', 'recently'];

  let notificationQueue = [];
  let isShowing = false;

  function createNotification(data) {
    const notification = document.createElement('div');
    notification.className = `social-proof-notification-elegant ${data.type}`;

    let content = '';

    switch(data.type) {
      case 'purchase':
        const product = data.products[Math.floor(Math.random() * data.products.length)];
        const location = data.locations[Math.floor(Math.random() * data.locations.length)];
        content = `
          <div class="social-proof-image-elegant">
            <span class="social-proof-icon-elegant">${data.icon}</span>
          </div>
          <div class="social-proof-content-elegant">
            <div class="social-proof-title-elegant">${data.title}</div>
            <div class="social-proof-message-elegant">${product}</div>
            <div class="social-proof-time-elegant">${location} • ${times[Math.floor(Math.random() * times.length)]}</div>
          </div>
        `;
        break;

      case 'review':
        const review = data.messages[Math.floor(Math.random() * data.messages.length)];
        const name = data.names[Math.floor(Math.random() * data.names.length)];
        content = `
          <div class="social-proof-image-elegant">
            <span class="social-proof-icon-elegant">${data.icon}</span>
          </div>
          <div class="social-proof-content-elegant">
            <div class="social-proof-title-elegant">${name}</div>
            <div class="social-proof-message-elegant">${review}</div>
            <div class="social-proof-time-elegant">${times[Math.floor(Math.random() * times.length)]}</div>
          </div>
        `;
        break;

      case 'visitor':
      case 'stock':
        const message = data.messages[Math.floor(Math.random() * data.messages.length)];
        content = `
          <div class="social-proof-image-elegant">
            <span class="social-proof-icon-elegant">${data.icon}</span>
          </div>
          <div class="social-proof-content-elegant">
            <div class="social-proof-title-elegant">${data.title}</div>
            <div class="social-proof-message-elegant">${message}</div>
          </div>
        `;
        break;
    }

    notification.innerHTML = content + '<button class="social-proof-close-elegant">&times;</button>';

    notification.querySelector('.social-proof-close-elegant').addEventListener('click', (e) => {
      e.stopPropagation();
      hideNotification(notification);
    });

    notification.addEventListener('click', () => {
      if (data.type === 'purchase') {
        window.location.href = '/collections/all';
      }
    });

    return notification;
  }

  function showNotification(notification) {
    container.appendChild(notification);
    isShowing = true;

    setTimeout(() => {
      notification.classList.add('show');
    }, 100);

    setTimeout(() => {
      hideNotification(notification);
    }, 5500);
  }

  function hideNotification(notification) {
    notification.classList.remove('show');
    notification.classList.add('hide');

    setTimeout(() => {
      if (notification.parentNode) {
        notification.parentNode.removeChild(notification);
      }
      isShowing = false;
      processQueue();
    }, 600);
  }

  function processQueue() {
    if (notificationQueue.length > 0 && !isShowing) {
      const next = notificationQueue.shift();
      showNotification(next);
    }
  }

  function queueNotification(type) {
    const data = notifications.find(n => n.type === type);
    if (data) {
      const notification = createNotification(data);
      notificationQueue.push(notification);
      processQueue();
    }
  }

  // Schedule notifications
  function scheduleNotifications() {
    const types = ['purchase', 'review', 'purchase', 'visitor', 'purchase', 'stock'];
    let index = 0;

    setTimeout(() => {
      queueNotification(types[index]);
      index = (index + 1) % types.length;

      setInterval(() => {
        queueNotification(types[index]);
        index = (index + 1) % types.length;
      }, 18000 + Math.random() * 12000);
    }, 10000);
  }

  scheduleNotifications();

  window.showSocialProof = queueNotification;
});
</script>
