<!-- Real-time Social Proof Notifications -->
<div id="social-proof-container" class="social-proof-container"></div>

<style>
.social-proof-container {
  position: fixed;
  bottom: 20px;
  left: 20px;
  z-index: 9990;
  display: flex;
  flex-direction: column;
  gap: 10px;
  pointer-events: none;
}

.social-proof-notification {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  transform: translateX(-120%);
  opacity: 0;
  transition: all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  pointer-events: auto;
  max-width: 320px;
  cursor: pointer;
}

.social-proof-notification.show {
  transform: translateX(0);
  opacity: 1;
}

.social-proof-notification.hide {
  transform: translateX(-120%);
  opacity: 0;
}

.social-proof-image {
  width: 50px;
  height: 50px;
  border-radius: 8px;
  background: linear-gradient(135deg, #f5f5f5, #e0e0e0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  flex-shrink: 0;
  overflow: hidden;
}

.social-proof-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.social-proof-content {
  flex: 1;
  min-width: 0;
}

.social-proof-title {
  font-size: 0.8rem;
  color: #666;
  margin-bottom: 2px;
}

.social-proof-message {
  font-size: 0.9rem;
  font-weight: 600;
  color: #1A1A1A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.social-proof-time {
  font-size: 0.75rem;
  color: #999;
  margin-top: 2px;
}

.social-proof-close {
  position: absolute;
  top: 5px;
  right: 8px;
  width: 20px;
  height: 20px;
  border: none;
  background: none;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.3s ease;
  font-size: 16px;
  color: #999;
}

.social-proof-notification:hover .social-proof-close {
  opacity: 1;
}

/* Different notification types */
.social-proof-notification.purchase {
  border-left: 4px solid #2D5A4A;
}

.social-proof-notification.review {
  border-left: 4px solid #FFD700;
}

.social-proof-notification.visitor {
  border-left: 4px solid #3498db;
}

.social-proof-notification.stock {
  border-left: 4px solid #e74c3c;
}

/* Animated icons */
.social-proof-icon {
  animation: socialProofPulse 2s ease-in-out infinite;
}

@keyframes socialProofPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* Visitor counter badge */
.visitor-counter {
  position: fixed;
  top: 100px;
  right: 20px;
  background: rgba(255,255,255,0.95);
  padding: 10px 16px;
  border-radius: 30px;
  box-shadow: 0 2px 15px rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  z-index: 100;
  opacity: 0;
  transform: translateX(100px);
  transition: all 0.5s ease;
}

.visitor-counter.show {
  opacity: 1;
  transform: translateX(0);
}

.visitor-counter-dot {
  width: 8px;
  height: 8px;
  background: #2ecc71;
  border-radius: 50%;
  animation: visitorPulse 1.5s ease-in-out infinite;
}

@keyframes visitorPulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(46, 204, 113, 0.4); }
  50% { opacity: 0.8; box-shadow: 0 0 0 8px rgba(46, 204, 113, 0); }
}

.visitor-counter-number {
  font-weight: 700;
  color: #2D5A4A;
}

/* Stock counter */
.stock-alert {
  position: fixed;
  top: 150px;
  right: 20px;
  background: #fff3cd;
  border: 1px solid #ffc107;
  padding: 10px 16px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  z-index: 100;
  opacity: 0;
  transform: translateX(100px);
  transition: all 0.5s ease;
}

.stock-alert.show {
  opacity: 1;
  transform: translateX(0);
}

.stock-alert-icon {
  font-size: 1.2rem;
}

/* Mobile adjustments */
@media (max-width: 768px) {
  .social-proof-container {
    left: 10px;
    bottom: 100px;
  }

  .social-proof-notification {
    max-width: 280px;
    padding: 10px 12px;
  }

  .visitor-counter,
  .stock-alert {
    right: 10px;
    font-size: 0.75rem;
    padding: 8px 12px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const container = document.getElementById('social-proof-container');

  // Sample data - in production, this would come from your backend
  const notifications = [
    {
      type: 'purchase',
      icon: '🛒',
      title: 'Someone just purchased',
      products: ['Vitamin C Serum', 'Hyaluronic Acid Cream', 'Retinol Night Serum', 'Gentle Cleanser', 'Mineral Sunscreen'],
      locations: ['New York', 'Los Angeles', 'Chicago', 'Miami', 'Seattle', 'Austin', 'Denver', 'Boston']
    },
    {
      type: 'review',
      icon: '⭐',
      title: 'New 5-star review',
      messages: [
        '"Best serum I\'ve ever used!"',
        '"My skin has never looked better"',
        '"Worth every penny!"',
        '"Finally found my holy grail"',
        '"Obsessed with this product!"'
      ],
      names: ['Sarah M.', 'Jessica L.', 'Emily R.', 'Amanda K.', 'Rachel T.']
    },
    {
      type: 'visitor',
      icon: '👀',
      title: 'Trending now',
      messages: [
        '23 people viewing this',
        '15 added to cart today',
        'Bestseller this week',
        '47 sold in last 24 hours'
      ]
    },
    {
      type: 'stock',
      icon: '🔥',
      title: 'Low stock alert',
      messages: [
        'Only 3 left in stock!',
        'Selling fast - 5 remaining',
        'Almost sold out!',
        'Last few items available'
      ]
    }
  ];

  const times = ['just now', '2 min ago', '5 min ago', '8 min ago', '12 min ago'];

  let notificationQueue = [];
  let isShowing = false;

  function createNotification(data) {
    const notification = document.createElement('div');
    notification.className = `social-proof-notification ${data.type}`;

    let content = '';

    switch(data.type) {
      case 'purchase':
        const product = data.products[Math.floor(Math.random() * data.products.length)];
        const location = data.locations[Math.floor(Math.random() * data.locations.length)];
        content = `
          <div class="social-proof-image">
            <span class="social-proof-icon">${data.icon}</span>
          </div>
          <div class="social-proof-content">
            <div class="social-proof-title">${data.title}</div>
            <div class="social-proof-message">${product}</div>
            <div class="social-proof-time">📍 ${location} • ${times[Math.floor(Math.random() * times.length)]}</div>
          </div>
        `;
        break;

      case 'review':
        const review = data.messages[Math.floor(Math.random() * data.messages.length)];
        const name = data.names[Math.floor(Math.random() * data.names.length)];
        content = `
          <div class="social-proof-image">
            <span class="social-proof-icon">${data.icon}</span>
          </div>
          <div class="social-proof-content">
            <div class="social-proof-title">${name} left a review</div>
            <div class="social-proof-message">${review}</div>
            <div class="social-proof-time">⭐⭐⭐⭐⭐ • ${times[Math.floor(Math.random() * times.length)]}</div>
          </div>
        `;
        break;

      case 'visitor':
      case 'stock':
        const message = data.messages[Math.floor(Math.random() * data.messages.length)];
        content = `
          <div class="social-proof-image">
            <span class="social-proof-icon">${data.icon}</span>
          </div>
          <div class="social-proof-content">
            <div class="social-proof-title">${data.title}</div>
            <div class="social-proof-message">${message}</div>
          </div>
        `;
        break;
    }

    notification.innerHTML = content + '<button class="social-proof-close">&times;</button>';

    notification.querySelector('.social-proof-close').addEventListener('click', (e) => {
      e.stopPropagation();
      hideNotification(notification);
    });

    notification.addEventListener('click', () => {
      if (data.type === 'purchase') {
        window.location.href = '/collections/all';
      }
    });

    return notification;
  }

  function showNotification(notification) {
    container.appendChild(notification);
    isShowing = true;

    setTimeout(() => {
      notification.classList.add('show');
    }, 100);

    setTimeout(() => {
      hideNotification(notification);
    }, 5000);
  }

  function hideNotification(notification) {
    notification.classList.remove('show');
    notification.classList.add('hide');

    setTimeout(() => {
      if (notification.parentNode) {
        notification.parentNode.removeChild(notification);
      }
      isShowing = false;
      processQueue();
    }, 500);
  }

  function processQueue() {
    if (notificationQueue.length > 0 && !isShowing) {
      const next = notificationQueue.shift();
      showNotification(next);
    }
  }

  function queueNotification(type) {
    const data = notifications.find(n => n.type === type);
    if (data) {
      const notification = createNotification(data);
      notificationQueue.push(notification);
      processQueue();
    }
  }

  // Show notifications periodically
  function scheduleNotifications() {
    const types = ['purchase', 'review', 'purchase', 'visitor', 'purchase', 'stock'];
    let index = 0;

    // First notification after 8 seconds
    setTimeout(() => {
      queueNotification(types[index]);
      index = (index + 1) % types.length;

      // Then every 15-25 seconds
      setInterval(() => {
        queueNotification(types[index]);
        index = (index + 1) % types.length;
      }, 15000 + Math.random() * 10000);
    }, 8000);
  }

  // Visitor counter
  function showVisitorCounter() {
    const counter = document.createElement('div');
    counter.className = 'visitor-counter';
    counter.innerHTML = `
      <span class="visitor-counter-dot"></span>
      <span><span class="visitor-counter-number">${12 + Math.floor(Math.random() * 20)}</span> people viewing now</span>
    `;
    document.body.appendChild(counter);

    setTimeout(() => counter.classList.add('show'), 3000);

    // Update count occasionally
    setInterval(() => {
      const num = counter.querySelector('.visitor-counter-number');
      const current = parseInt(num.textContent);
      const change = Math.floor(Math.random() * 5) - 2;
      num.textContent = Math.max(8, Math.min(35, current + change));
    }, 10000);
  }

  // Initialize
  scheduleNotifications();
  showVisitorCounter();

  // Expose for external triggers
  window.showSocialProof = queueNotification;
});
</script>
